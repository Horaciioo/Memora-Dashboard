# Branch this deployment runs: dev, staging, release, main
APP_ENV=dev

# Prisma datasource, required by prisma generate and prisma validate
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard?schema=public

# Every variable below is optional: an unset variable keeps the JSON default
# declared in src/configurations/default/<subject>.default.json

# Database
DATABASE_ENABLED=false
DATABASE_CACHE_TTL=300
DATABASE_SYNCHRONIZE=false
DATABASE_SYNCHRONIZE_EVENT=cache:mutation

# Redis
REDIS_ENABLED=false
REDIS_PREFIX=dashboard:
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queues
QUEUES_ENABLED=false
QUEUES_PREFIX=dashboard:queues
QUEUES_CONCURRENCY=4

# Storage
STORAGE_ENABLED=false
STORAGE_DRIVER=database
STORAGE_MAX_BYTES=10485760

# Encryption
ENCRYPTION_ENABLED=false
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=
ENCRYPTION_KEY_SALT=
ENCRYPTION_IV=
ENCRYPTION_IV_SALT=

# Telemetry
TELEMETRY_ENABLED=false
TELEMETRY_SOURCE_KEY=
TELEMETRY_ENDPOINT=

# Logger
LOGGER_LEVEL=info
LOGGER_CONSOLE=true
LOGGER_FILE=false
LOGGER_DIRECTORY=logs
LOGGER_TELEMETRY=false

# Uptime
UPTIME_ENABLED=false
UPTIME_INTERVAL_MS=60000
UPTIME_ENDPOINT=

# Sentry, read by src/core/lib/sentry.ts
NEXT_PUBLIC_SENTRY_DSN=
