{
  "name": "memora-dashboard",
  "version": "0.2.0-snapshot.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "yarn version:check && prisma generate && yarn openapi:generate && next build",
    "openapi:generate": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-openapi-manifest.ts",
    "version:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/versioning/check.ts",
    "snapshot": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/versioning/snapshot.ts",
    "release": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/versioning/release.ts",
    "promote": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/versioning/promote.ts",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "yarn openapi:generate && tsc --noEmit",
    "comments:trim": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/comments/trim.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "yarn type-check && yarn lint && yarn test && yarn build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.ts",
    "fixtures:seed": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./fixtures/loader.mjs fixtures/seed-demo.ts",
    "fixtures:qa": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./fixtures/loader.mjs fixtures/qa.ts",
    "fixtures:clear": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./fixtures/loader.mjs fixtures/teardown.ts",
    "db:verify-backup": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/verify-backup.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@logtail/node": "^0.5.8",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10",
    "@tanstack/react-query": "^5.104.0",
    "bullmq": "^6.1.2",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "winston": "^3.19.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.17.1"
}
