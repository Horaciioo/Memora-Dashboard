generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Hierarchy level, drives the permission matrix
enum MemberRole {
  ADMIN
  EMPLOYE
  RESPONSABLE
  MODERATEUR
  JUNIOR
}

// Rail section of the access console, grouping the roles and the functions under one heading
enum AccessCategory {
  LEADER
  EMPLOYE
  ADMINISTRATION
  RESPONSABILITE
  MODERATION
  JUNIOR
  JUNIOR_RESPONSABLE
}

// Writing progress of an announcement
enum CommunicationStatus {
  PLANNED
  WRITING
  WRITTEN
  PUBLISHED
  CANCELLED
}

// Lifecycle of a member inside the organisation
enum MemberStatus {
  PENDING
  ACADEMY
  ACTIVE
  PAUSED
  LEFT
  DISMISSED
  RESIGNED
}

// What an integration link does once its form is submitted
enum IntegrationLinkKind {
  ACCOUNT
  PROFILE
  ACADEMY
}

// Kind of personal constraint a member volunteers
enum ConstraintKind {
  MEDICAL
  ILLNESS
  PRIVATE
}

// Academy period a training belongs to
enum AcademyPeriod {
  DISCOVERY
  PRACTICE
}

// Lifecycle of a session
enum AcademySessionStatus {
  DRAFT
  OPEN
  RUNNING
  CLOSED
  ARCHIVED
}

// Outcome of a junior inside a session
enum AcademyJuniorStatus {
  ACTIVE
  VALIDATED
  STOPPED
  RESIGNED
}

// Why a member left during their PIM
enum DepartureKind {
  DISMISSAL
  RESIGNATION
}

// Broad phase of a junior's PIM, drives which timeline steps are open
enum AcademyStage {
  PREPARATION
  DISCOVERY
  REVIEW_ONE
  PRACTICE
  REVIEW_FINAL
  BONUS
}

// What a stored Discord identifier points at
enum DiscordIdKind {
  MEMBER
  ROLE
  ACADEMY_ROLE
  RECRUITMENT_ROLE
  TEXT_CHANNEL
  VOICE_CHANNEL
  SERVER
}

// Kind of trace kept on a junior's FSI
enum NoteKind {
  POSITIVE
  NEGATIVE
}

// Outcome of a junior's personal objective
enum ObjectiveStatus {
  OPEN
  REACHED
  MISSED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ABANDONED
}

// Outcome a Formateur proposes at the end of a voice check-in
enum ReviewAdvice {
  PASS
  BONUS
  STOP
}

// Lifecycle of a voice check-in
enum ReviewStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  REJECTED
}

// Surface a workflow state belongs to
enum WorkflowScope {
  PROJECT
  TASK
  MEETING
}

// Lifecycle bucket of a workflow state
enum WorkflowPhase {
  TODO
  DOING
  DONE
}

// Role held inside a meeting
enum AttendeeKind {
  LEAD
  ASSISTANT
  PARTICIPANT
}

// Who a meeting is held for: the whole team, one trade's team, or a custom list of seats
enum MeetingAudience {
  EVERYONE
  ADMINISTRATION
  DISCORD
  TWITCH
  CUSTOM
  TEAM
}

// Review outcome of an absence request
enum AbsenceStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

// Whether a function is held as main or secondary
enum FunctionKind {
  PRIMARY
  SECONDARY
}

// Whether an account permission is granted or taken away
enum PermissionEffect {
  ALLOW
  DENY
}

// Shape a calendar entry takes on the grid, never editable from the console
enum CalendarKind {
  ZONE
  PERIOD
  EVENT
}

// Who a calendar entry is shown to
enum EventVisibility {
  EVERYONE
  RESPONSABLES
  ADMINS
  TEAM
  YOUTUBER
}

// Where a member stands on a roll-call
enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

// Streaming platform a live runs on
enum LivePlatform {
  TWITCH
  YOUTUBE
}

// Gesture of a moderation log line
enum ModerationKind {
  DELETE
  TIMEOUT
  BAN
  UNBAN
  WARN
  AUTOMOD_APPROVE
  AUTOMOD_DENY
  TERM_ADD
  TERM_REMOVE
  MODE_CHANGE
  UNBAN_REQUEST_APPROVE
  UNBAN_REQUEST_DENY
  MESSAGE_SEND
}

// Where a moderation gesture was made
enum ModerationOrigin {
  MEMORA
  PLATFORM
}

// Outcome of a gesture sent from Memora
enum ModerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Why a Mod View presence closed
enum PresenceCloseReason {
  CLOSED
  TIMEOUT
  LIVE_ENDED
}

// Lifecycle of an announced live
enum LiveStatus {
  ANNOUNCED
  LIVE
  ENDED
  CANCELLED
}

// Answer of a member asked to coordinate a live
enum CoordinationStatus {
  ASKED
  ACCEPTED
  DECLINED
}

// Signed-in member
model Account {
  id                    String       @id @default(cuid())
  discordId             String       @unique
  discordUsername       String?
  discordAvatarHash     String?
  discordSyncedAt       DateTime?
  displayName           String
  birthday              DateTime?
  celebrateBirthday     Boolean      @default(true)
  joinedAt              DateTime     @default(now())
  leftAt                DateTime?
  historyConsentAt      DateTime?
  historyConsentVersion Int?
  // Last release note read
  seenReleaseVersion    String?
  // One-time guides already shown, by key
  seenGuides            String[]     @default([])
  // Pages starred from the banner, by path
  favorites             Json         @default("[]")
  // Pages beside Home in the phone dock, by path
  mobileDock            String[]     @default([])
  // Push categories the member silenced
  pushMutedCategories   String[]     @default([])
  anonymisedAt          DateTime?
  // Access shut until lifted
  frozenAt              DateTime?
  languages             String[]     @default([])
  timezone              String?
  theme                 String?
  colorVision           String?
  fontScale             String?
  avatarUrl             String?
  bannerUrl             String?
  role                  MemberRole   @default(MODERATEUR)
  status                MemberStatus @default(ACADEMY)
  divisionId            String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  division  Division?         @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  youtubers Youtuber[]
  functions AccountFunction[]

  sessions              Session[]
  pushSubscriptions     PushSubscription[]
  pushDeliveries        PushDelivery[]
  discordToken          DiscordToken?
  twoFactor             TwoFactorCredential?
  ledYoutubers          YoutuberLead[]           @relation("YoutuberLead")
  permissions           AccountPermission[]
  socialLinks           SocialLink[]
  constraints           AccountConstraint[]
  calendarEntries       CalendarEvent[]          @relation("CalendarSubject")
  trainedEvents         CalendarEvent[]          @relation("CalendarTrainer")
  absences              Absence[]                @relation("AbsenceOwner")
  reviewedAbsences      Absence[]                @relation("AbsenceReviewer")
  notesReceived         AccountNote[]            @relation("NoteSubject")
  notesWritten          AccountNote[]            @relation("NoteAuthor")
  trainingRecords       TrainingRecord[]         @relation("TrainingLearner")
  trainingsValidated    TrainingRecord[]         @relation("TrainingValidator")
  academyJuniors        AcademyJunior[]          @relation("AcademyJunior")
  legacyTracks          LegacyTrack[]            @relation("LegacyMember")
  legacyDecisions       LegacyTrack[]            @relation("LegacyDecider")
  legacyGrades          LegacyModuleResult[]     @relation("LegacyGrader")
  academyTrainees       AcademyJunior[]          @relation("AcademyJuniorTrainer")
  academySeats          AcademySessionTrainer[]  @relation("AcademyTrainer")
  integrationInvites    IntegrationInvite[]      @relation("IntegrationInviteCreatedBy")
  integrationClaims     IntegrationClaim[]       @relation("IntegrationClaimAccount")
  quizAnswers           JuniorAnswer[]
  trainingFeedbacks     TrainingFeedback[]
  moderationActions     ModerationAction[]       @relation("ModerationActor")
  viewerComments        ViewerComment[]          @relation("ViewerCommentAuthor")
  modStints             LiveModStint[]           @relation("ModStintAccount")
  moderationsOnBehalf   ModerationAction[]       @relation("ModerationOnBehalf")
  focusesWatching       ModViewFocus[]           @relation("FocusWatcher")
  focusesWatched        ModViewFocus[]           @relation("FocusTarget")
  modViewPresences      ModViewPresence[]
  academyReviews        AcademyReview[]          @relation("AcademyReviewAuthor")
  academyReviewsDecided AcademyReview[]          @relation("AcademyReviewDecider")
  juniorSkillsGraded    JuniorSkill[]            @relation("JuniorSkillValidator")
  juniorNotesWritten    JuniorNote[]             @relation("JuniorNoteAuthor")
  juniorObjectivesSet   JuniorObjective[]        @relation("JuniorObjectiveAuthor")
  calendarEvents        CalendarEvent[]          @relation("CalendarOwner")
  eventAttendances      EventAttendance[]
  ledTeams              TeamLead[]
  teamMemberships       TeamMember[]
  projectLeads          ProjectLead[]
  projectAssists        ProjectAssistant[]
  ownedTasks            Task[]                   @relation("TaskOwner")
  meetingSeats          MeetingAttendee[]
  projectsOpened        Project[]                @relation("ProjectAuthor")
  projectsEdited        Project[]                @relation("ProjectEditor")
  tasksOpened           Task[]                   @relation("TaskAuthor")
  tasksEdited           Task[]                   @relation("TaskEditor")
  meetingsPlanned       Meeting[]                @relation("MeetingAuthor")
  meetingsEdited        Meeting[]                @relation("MeetingEditor")
  communications        Communication[]
  liveconChanges        LiveconEntry[]
  departureNotices      DepartureNotice[]        @relation("DepartureSubject")
  departuresPublished   DepartureNotice[]        @relation("DeparturePublisher")
  liveSuspensions       LiveSuspension[]         @relation("SuspensionSubject")
  liveSuspensionsIssued LiveSuspension[]         @relation("SuspensionAuthor")
  platformAccounts      PlatformAccount[]
  livesAnnounced        Live[]                   @relation("LiveAnnouncer")
  liveCoordinations     LiveCoordination[]
  liveSeats             LiveMember[]
  playSessionsHosted    PlaySession[]            @relation("PlaySessionHost")
  playTournamentsHosted PlayTournament[]         @relation("PlayTournamentHost")
  playSeats             PlaySeat[]
  playStats             PlayGameStat[]
  playProfile           PlayProfile?
  baccalaureatAnswers   BaccalaureatAnswer[]
  baccalaureatVotes     BaccalaureatVote[]
  bombPlayers           BombPlayer[]
  bombMoves             BombMove[]
  golfPlayers           GolfPlayer[]
  golfMoves             GolfMove[]
  ludoPlayers           LudoPlayer[]
  ludoMoves             LudoMove[]
  playMessages          PlayMessage[]
  playInvitesSent       PlayInvite[]             @relation("PlayInviteFrom")
  playInvitesReceived   PlayInvite[]             @relation("PlayInviteTo")
  activityAsSubject     ActivityLog[]            @relation("LogSubject")
  activityAsActor       ActivityLog[]            @relation("LogActor")
  notificationsReceived Notification[]           @relation("NotificationRecipient")
  notificationsCaused   Notification[]           @relation("NotificationActor")
  recruitmentInterviews RecruitmentCandidate[]   @relation("RecruitmentRecruiter")
  candidateRecruiters   CandidateRecruiter[]     @relation("CandidateRecruiter")
  recruitmentSeats      RecruitmentSeat[]        @relation("RecruitmentSeat")
  recruitmentBans       RecruitmentBan[]         @relation("RecruitmentBanAuthor")
  recruitmentLeads      RecruitmentResponsable[] @relation("RecruitmentResponsable")
  recruitmentLed        RecruitmentRecruiter[]   @relation("RecruitmentRecruiter")
  recruitmentWatches    RecruitmentObserver[]    @relation("RecruitmentObserver")
  recruitmentComments   RecruitmentComment[]     @relation("RecruitmentCommentAuthor")
  academyComments       AcademyComment[]         @relation("AcademyCommentAuthor")
  workComments          WorkComment[]            @relation("WorkCommentAuthor")
  exerciseLinks         ExerciseLink[]           @relation("ExerciseLinkCreatedBy")
  pagesOwned            Page[]                   @relation("PageOwner")
  pagesEdited           Page[]                   @relation("PageEditor")
  pageGrants            PageGrant[]              @relation("PageGrantAccount")
  pageGrantsGiven       PageGrant[]              @relation("PageGrantAuthor")
  pageMedia             PageMedia[]              @relation("PageMediaUploader")
  pageRevisions         PageRevision[]           @relation("PageRevisionAuthor")
  pageComments          PageComment[]            @relation("PageCommentAuthor")

  @@index([role])
  @@index([status])
  @@index([divisionId])
  @@map("accounts")
}

// Departure announcement drafted for the responsables, a task until published
model DepartureNotice {
  id            String        @id @default(cuid())
  accountId     String
  kind          DepartureKind
  functionName  String
  body          String
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime      @default(now())

  account     Account  @relation("DepartureSubject", fields: [accountId], references: [id], onDelete: Cascade)
  publishedBy Account? @relation("DeparturePublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@map("departure_notices")
}

// Pause on a member's access to the live moderation
model LiveSuspension {
  id          String    @id @default(cuid())
  accountId   String
  startsAt    DateTime  @default(now())
  endsAt      DateTime
  reason      String?
  createdById String?
  liftedAt    DateTime?
  createdAt   DateTime  @default(now())

  account   Account  @relation("SuspensionSubject", fields: [accountId], references: [id], onDelete: Cascade)
  createdBy Account? @relation("SuspensionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId, endsAt])
  @@map("live_suspensions")
}

// Signed cookie handle of an open session
model Session {
  id         String    @id @default(cuid())
  token      String    @unique
  accountId  String
  userAgent  String?
  address    String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  unsealedAt DateTime?

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

// Browser able to show system notifications, dropped with the session that opened it
model PushSubscription {
  id         String    @id @default(cuid())
  accountId  String
  sessionId  String
  endpoint   String    @unique
  p256dh     String
  auth       String
  device     String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  account    Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([accountId])
  @@index([sessionId])
  @@map("push_subscriptions")
}

// One push handed to a push service, read back by the journal
model PushDelivery {
  id             String    @id @default(cuid())
  accountId      String
  notificationId String?
  subscriptionId String?
  kind           Int
  status         Int
  statusCode     Int?
  device         String?
  isTest         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notification Notification?     @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  subscription PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([notificationId, subscriptionId])
  @@index([createdAt])
  @@index([accountId, createdAt])
  @@index([subscriptionId])
  @@map("push_deliveries")
}

// Second factor of one member, its secret encrypted at rest like every other stored secret
model TwoFactorCredential {
  id          String    @id @default(cuid())
  accountId   String    @unique
  secret      String
  confirmedAt DateTime?
  lastStep    BigInt?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recoveryCodes TwoFactorRecoveryCode[]

  @@map("two_factor_credentials")
}

// Single-use fallback code, only ever stored as a digest
model TwoFactorRecoveryCode {
  id           String    @id @default(cuid())
  credentialId String
  digest       String
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  credential TwoFactorCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, digest])
  @@index([credentialId])
  @@map("two_factor_recovery_codes")
}

// OAuth grant of one member, both token halves encrypted at rest
model DiscordToken {
  id           String   @id @default(cuid())
  accountId    String   @unique
  accessToken  String
  refreshToken String
  scope        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("discord_tokens")
}

// Per-account override on top of role and function grants
model AccountPermission {
  id         String           @id @default(cuid())
  accountId  String
  permission String
  effect     PermissionEffect @default(ALLOW)
  youtuberId String?
  createdAt  DateTime         @default(now())

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  youtuber Youtuber? @relation(fields: [youtuberId], references: [id], onDelete: Cascade)

  @@index([accountId, youtuberId])
  @@index([youtuberId])
  @@map("account_permissions")
}

// Permissions attached to a hierarchy level
model RolePermission {
  id         String           @id @default(cuid())
  role       MemberRole
  permission String
  effect     PermissionEffect @default(ALLOW)
  youtuberId String?

  youtuber Youtuber? @relation(fields: [youtuberId], references: [id], onDelete: Cascade)

  @@index([role, youtuberId])
  @@index([youtuberId])
  @@map("role_permissions")
}

// Permission batch already landed, keeping every later sync purely additive
model GrantMigration {
  key       String   @id
  appliedAt DateTime @default(now())

  @@map("grant_migrations")
}

// Colour and glyph override of a hierarchy level, edited from the access console
model RoleAppearance {
  role   MemberRole @id
  accent String?
  icon   String?

  @@map("role_appearances")
}

// Extra permissions carried by a moderation function
// Function held by an account, as many primary and secondary ones as it carries
model AccountFunction {
  id         String   @id @default(cuid())
  accountId  String
  functionId String
  createdAt  DateTime @default(now())

  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  jobFunction JobFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([accountId, functionId])
  @@index([functionId])
  @@map("account_functions")
}

model FunctionPermission {
  id         String           @id @default(cuid())
  functionId String
  permission String
  effect     PermissionEffect @default(ALLOW)
  youtuberId String?

  jobFunction JobFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  youtuber    Youtuber?   @relation(fields: [youtuberId], references: [id], onDelete: Cascade)

  @@index([functionId, youtuberId])
  @@index([youtuberId])
  @@map("function_permissions")
}

// Creator whose community the work is done for
model Youtuber {
  id            String   @id @default(cuid())
  name          String   @unique
  handle        String?
  accent        String?
  avatarUrl     String?
  // Small mark, apart from the portrait
  logoUrl       String?
  // First banner of the bank, kept for the readers of a single banner
  bannerUrl     String?
  // Faded banner of the moderators and live views
  fadeBannerUrl String?
  position      Int      @default(0)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts            Account[]
  banners             YoutuberBanner[]
  leads               YoutuberLead[]
  functions           YoutuberFunction[]
  rolePermissions     RolePermission[]
  functionPermissions FunctionPermission[]
  accountPermissions  AccountPermission[]
  teams               Team[]
  projects            Project[]
  tasks               Task[]
  meetings            Meeting[]
  liveconEntries      LiveconEntry[]
  calendarEvents      CalendarEvent[]
  channels            YoutuberChannel[]
  discordIdentifiers  DiscordIdentifier[]
  lives               Live[]
  viewerComments      ViewerComment[]
  sanctionOffenses    SanctionOffense[]

  recruitmentSessions      RecruitmentSession[]
  recruitmentQuestions     RecruitmentQuestion[]
  recruitmentStepTemplates RecruitmentStepTemplate[]
  integrationInvites       IntegrationInvite[]

  @@index([archived])
  @@map("youtubers")
}

// Banner collected in the bank of one creator
model YoutuberBanner {
  id         String   @id @default(cuid())
  youtuberId String
  url        String
  // Place using it, one banner per place
  slot       String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  youtuber Youtuber @relation(fields: [youtuberId], references: [id], onDelete: Cascade)

  @@unique([youtuberId, slot])
  @@index([youtuberId, position])
  @@map("youtuber_banners")
}

// Function one creator opens, the catalogue itself staying global
model YoutuberFunction {
  id         String   @id @default(cuid())
  youtuberId String
  functionId String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  youtuber    Youtuber    @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  jobFunction JobFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([youtuberId, functionId])
  @@index([functionId])
  @@map("youtuber_functions")
}

// Responsable anchored on one creator, optionally narrowed to one of its teams. Only an
// administrator writes this row — it is what a responsable's whole perimeter is read from
model YoutuberLead {
  id         String   @id @default(cuid())
  youtuberId String
  accountId  String
  teamId     String?
  createdAt  DateTime @default(now())

  youtuber Youtuber @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  account  Account  @relation("YoutuberLead", fields: [accountId], references: [id], onDelete: Cascade)
  team     Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([youtuberId, accountId])
  @@index([accountId])
  @@index([teamId])
  @@map("youtuber_leads")
}

// Gamification tier, Junior then the three squads
model Division {
  id             String   @id @default(cuid())
  name           String   @unique
  glyph          String?
  imagePath      String?
  summary        String?
  rank           Int      @unique
  // Cleared, only an administrator may put a member in this division
  leadAssignable Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts Account[]

  @@map("divisions")
}

// Moderation post held by a member
model JobFunction {
  id        String         @id @default(cuid())
  name      String         @unique
  kind      FunctionKind   @default(PRIMARY)
  category  AccessCategory @default(MODERATION)
  icon      String?
  summary   String?
  accent    String?
  position  Int            @default(0)
  archived  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  holders         AccountFunction[]
  legacyTracks    LegacyTrack[]
  permissions     FunctionPermission[]
  trainings       Training[]
  skills          Skill[]
  academySessions AcademySession[]
  youtubers       YoutuberFunction[]
  teams           Team[]

  recruitmentSessions      RecruitmentSession[]
  recruitmentQuestions     RecruitmentQuestion[]
  recruitmentStepTemplates RecruitmentStepTemplate[]
  integrationInvites       IntegrationInvite[]

  @@index([kind])
  @@index([category])
  @@map("job_functions")
}

// Surface where the work actually happens
model Platform {
  id        String   @id @default(cuid())
  name      String   @unique
  accent    String?
  avatarUrl String?
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  communications Communication[]

  @@map("platforms")
}

// Column of a board, scoped to one surface
model WorkflowState {
  id        String        @id @default(cuid())
  scope     WorkflowScope
  name      String
  accent    String?
  position  Int           @default(0)
  isDefault Boolean       @default(false)
  phase     WorkflowPhase @default(TODO)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  projects Project[]
  tasks    Task[]
  meetings Meeting[]

  @@unique([scope, name])
  @@index([scope, position])
  @@map("workflow_states")
}

// Urgency level shared by projects and tasks
model Priority {
  id        String   @id @default(cuid())
  name      String   @unique
  accent    String?
  weight    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  tasks    Task[]

  @@map("priorities")
}

// Group of moderators under one responsable
model Team {
  id         String   @id @default(cuid())
  name       String
  summary    String?
  youtuberId String?
  // Function the team stands for, set on the automatic ones
  functionId String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  youtuber    Youtuber?      @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  jobFunction JobFunction?   @relation(fields: [functionId], references: [id], onDelete: SetNull)
  leads       TeamLead[]
  members     TeamMember[]
  anchors     YoutuberLead[]

  @@unique([youtuberId, functionId])
  @@index([youtuberId, archived])
  @@map("teams")
}

// Responsable or admin running a team
model TeamLead {
  id        String   @id @default(cuid())
  teamId    String
  accountId String
  createdAt DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([teamId, accountId])
  @@index([accountId])
  @@map("team_leads")
}

// Membership of an account inside a team
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  accountId String
  createdAt DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([teamId, accountId])
  @@map("team_members")
}

// Piece of work carried by a responsable
model Project {
  id                   String    @id @default(cuid())
  title                String
  emoji                String?
  description          String?
  stateId              String?
  priorityId           String?
  platformId           String?
  deadline             DateTime?
  createdById          String?
  updatedById          String?
  position             Int       @default(0)
  archived             Boolean   @default(false)
  // Set on the project the system opens for a recruitment and the academy it feeds
  systemKey            String?   @unique
  recruitmentSessionId String?   @unique
  academySessionId     String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdBy Account? @relation("ProjectAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Account? @relation("ProjectEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  youtubers Youtuber[]
  state     WorkflowState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  priority  Priority?      @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  platform  Platform?      @relation(fields: [platformId], references: [id], onDelete: SetNull)

  recruitmentSession RecruitmentSession? @relation(fields: [recruitmentSessionId], references: [id], onDelete: SetNull)
  academySession     AcademySession?     @relation(fields: [academySessionId], references: [id], onDelete: SetNull)

  leads          ProjectLead[]
  assistants     ProjectAssistant[]
  communications Communication[]
  tasks          Task[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  comments       WorkComment[]

  @@index([stateId, position])
  @@index([archived])
  @@map("projects")
}

// Responsable in charge of a project
model ProjectLead {
  id        String   @id @default(cuid())
  projectId String
  accountId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@map("project_leads")
}

// Helper attached to a project
model ProjectAssistant {
  id        String   @id @default(cuid())
  projectId String
  accountId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@map("project_assistants")
}

// Markdown announcement written for a project
model Communication {
  id          String              @id @default(cuid())
  projectId   String?
  authorId    String?
  platformId  String?
  title       String
  body        String              @default("")
  status      CommunicationStatus @default(PLANNED)
  publishedAt DateTime?
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project  Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   Account?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  platform Platform?     @relation(fields: [platformId], references: [id], onDelete: SetNull)
  comments WorkComment[]

  @@index([projectId, position])
  @@map("communications")
}

// Single action assigned to one member
model Task {
  id          String    @id @default(cuid())
  title       String
  emoji       String?
  description String?
  dueDate     DateTime?
  ownerId     String?
  stateId     String?
  priorityId  String?
  projectId   String?
  createdById String?
  updatedById String?
  position    Int       @default(0)
  archived    Boolean   @default(false)
  // Set on tasks the system opens and closes by itself, with the page they lead to
  systemKey   String?   @unique
  href        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy Account? @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Account? @relation("TaskEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  owner     Account?       @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  state     WorkflowState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  priority  Priority?      @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  youtubers Youtuber[]
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments  WorkComment[]

  @@index([stateId, position])
  @@index([ownerId])
  @@index([projectId])
  @@map("tasks")
}

// Scheduled gathering around a project
model Meeting {
  id           String          @id @default(cuid())
  title        String
  emoji        String?
  introduction String?
  outro        String?
  minutes      String?
  scheduledAt  DateTime?
  durationMin  Int?
  audience     MeetingAudience @default(CUSTOM)
  stateId      String?
  projectId    String?
  createdById  String?
  updatedById  String?
  position     Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  createdBy Account? @relation("MeetingAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Account? @relation("MeetingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  state     WorkflowState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  youtubers Youtuber[]
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  attendees      MeetingAttendee[]
  topics         MeetingTopic[]
  calendarEvents CalendarEvent[]
  comments       WorkComment[]

  @@index([scheduledAt])
  @@index([stateId, position])
  @@map("meetings")
}

// Point covered during a meeting
model MeetingTopic {
  id        String   @id @default(cuid())
  meetingId String
  emoji     String
  title     String
  body      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, position])
  @@map("meeting_topics")
}

// Seat held by a member in a meeting
model MeetingAttendee {
  id        String       @id @default(cuid())
  meetingId String
  accountId String
  kind      AttendeeKind @default(PARTICIPANT)
  createdAt DateTime     @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([meetingId, accountId])
  @@index([kind])
  @@map("meeting_attendees")
}

// Time off declared by a member
model Absence {
  id         String        @id @default(cuid())
  accountId  String
  startDate  DateTime
  endDate    DateTime
  dayCount   Int
  reasonCode Int?
  reason     String?
  status     AbsenceStatus @default(PENDING)
  reviewerId String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  account  Account  @relation("AbsenceOwner", fields: [accountId], references: [id], onDelete: Cascade)
  reviewer Account? @relation("AbsenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([accountId, startDate])
  @@index([status])
  @@map("absences")
}

// Private remark a responsable leaves on a member
model AccountNote {
  id        String   @id @default(cuid())
  accountId String
  authorId  String?
  body      String
  pinned    Boolean  @default(false)
  // Written by Memora itself, not by a member
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account  @relation("NoteSubject", fields: [accountId], references: [id], onDelete: Cascade)
  author  Account? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("account_notes")
}

// Reachable profile of a member elsewhere
model SocialLink {
  id        String   @id @default(cuid())
  accountId String
  networkId String?
  label     String
  handle    String
  url       String?
  accent    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  network SocialNetwork? @relation(fields: [networkId], references: [id], onDelete: SetNull)

  @@unique([accountId, label])
  @@index([accountId, position])
  @@index([networkId])
  @@map("social_links")
}

// Declared network a member profile can live on, its prefix sparing the whole URL
model SocialNetwork {
  id        String   @id @default(cuid())
  name      String   @unique
  urlPrefix String
  accent    String?
  avatarUrl String?
  required  Boolean  @default(false)
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links SocialLink[]

  @@map("social_networks")
}

// Health or private constraint a member volunteers, encrypted at rest and theirs to erase
model AccountConstraint {
  id        String         @id @default(cuid())
  accountId String
  kind      ConstraintKind
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind])
  @@map("account_constraints")
}

// Entry programme a junior is placed into, ATRIA or PULSE
model Dispositif {
  id        String   @id @default(cuid())
  name      String   @unique
  summary   String?
  accent    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills    Skill[]
  juniors   AcademyJunior[]
  trainings Training[]

  @@map("dispositifs")
}

// Grouping a skill sits under, Savoir-être, Technique, Rédaction...
model SkillCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  accent    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills Skill[]

  @@map("skill_categories")
}

// One competency a junior is graded on, scoped by function and dispositif
model Skill {
  id           String   @id @default(cuid())
  name         String
  description  String?
  position     Int      @default(0)
  categoryId   String
  functionId   String?
  dispositifId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobFunction JobFunction?  @relation(fields: [functionId], references: [id], onDelete: Cascade)
  dispositif  Dispositif?   @relation(fields: [dispositifId], references: [id], onDelete: Cascade)

  juniorSkills JuniorSkill[]

  @@unique([name, functionId, dispositifId])
  @@index([functionId, dispositifId])
  @@map("skills")
}

// Course a junior must clear during the academy
model Training {
  id            String         @id @default(cuid())
  name          String         @unique
  // Interactive course written in code, empty for a course edited from the console
  curriculumKey String?        @unique
  summary       String?
  period        AcademyPeriod?
  mandatory     Boolean        @default(false)
  functionId    String?
  dispositifId  String?
  position      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  jobFunction JobFunction?       @relation(fields: [functionId], references: [id], onDelete: SetNull)
  dispositif  Dispositif?        @relation(fields: [dispositifId], references: [id], onDelete: SetNull)
  records     TrainingRecord[]
  chapters    TrainingChapter[]
  feedbacks   TrainingFeedback[]

  @@index([period])
  @@index([functionId, dispositifId])
  @@map("trainings")
}

// Section a training's content is split into
model TrainingChapter {
  id         String   @id @default(cuid())
  trainingId String
  title      String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  training Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  blocks   TrainingBlock[]

  @@index([trainingId, position])
  @@map("training_chapters")
}

enum TrainingBlockKind {
  TEXT
  QUIZ
}

// One piece of a chapter, either a written passage or a quiz
model TrainingBlock {
  id        String            @id @default(cuid())
  chapterId String
  kind      TrainingBlockKind
  body      String?
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  chapter   TrainingChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([chapterId, position])
  @@map("training_blocks")
}

// One question of a quiz block
model QuizQuestion {
  id       String  @id @default(cuid())
  blockId  String
  prompt   String
  multiple Boolean @default(false)
  position Int     @default(0)

  block   TrainingBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  choices QuizChoice[]
  answers JuniorAnswer[]

  @@index([blockId, position])
  @@map("quiz_questions")
}

// One offered answer to a quiz question
model QuizChoice {
  id         String  @id @default(cuid())
  questionId String
  label      String
  correct    Boolean @default(false)
  position   Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
  @@map("quiz_choices")
}

// A member's own answer to one quiz question, overwritten on retake
model JuniorAnswer {
  id         String   @id @default(cuid())
  questionId String
  accountId  String
  choiceIds  String[] @default([])
  correct    Boolean
  answeredAt DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  account  Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([questionId, accountId])
  @@map("junior_answers")
}

// Attendance of one member on one training
model TrainingRecord {
  id          String         @id @default(cuid())
  trainingId  String
  accountId   String
  validatorId String?
  status      TrainingStatus @default(NOT_STARTED)
  attempts    Int            @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  abandonedAt DateTime?
  juniorId    String?
  note        String?
  // Answer and score of each exercise of an interactive course
  progress    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  training  Training       @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  account   Account        @relation("TrainingLearner", fields: [accountId], references: [id], onDelete: Cascade)
  validator Account?       @relation("TrainingValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  junior    AcademyJunior? @relation("TrainingJunior", fields: [juniorId], references: [id], onDelete: SetNull)

  @@unique([trainingId, accountId])
  @@index([juniorId])
  @@map("training_records")
}

// What a learner thought of a course, read by the administration and the responsables only
model TrainingFeedback {
  id         String   @id @default(cuid())
  trainingId String
  accountId  String
  // Scales from 1 to 10
  content    Int
  fluency    Int
  comment    String?
  createdAt  DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([trainingId, createdAt])
  @@index([accountId])
  @@map("training_feedbacks")
}

// Dated run of one training programme
model AcademySession {
  id             String               @id @default(cuid())
  functionId     String
  startsAt       DateTime
  endsAt         DateTime?
  status         AcademySessionStatus @default(DRAFT)
  summary        String?
  // Second period opened for the whole promotion
  secondPeriodAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  jobFunction JobFunction @relation(fields: [functionId], references: [id], onDelete: Restrict)

  trainers       AcademySessionTrainer[]
  juniors        AcademyJunior[]
  comments       AcademyComment[]
  calendarEvents CalendarEvent[]
  invites        IntegrationInvite[]

  recruitmentSession RecruitmentSession?
  project            Project?

  @@index([functionId, startsAt])
  @@index([status])
  @@map("academy_sessions")
}

// Public link carrying the integration form, its kind deciding what a submission creates
model IntegrationInvite {
  id                   String              @id @default(cuid())
  kind                 IntegrationLinkKind @default(ACCOUNT)
  token                String              @unique
  youtuberId           String?
  functionId           String?
  sessionId            String?
  recruitmentSessionId String?             @unique
  expiresAt            DateTime
  maxUses              Int?
  uses                 Int                 @default(0)
  createdById          String?
  createdAt            DateTime            @default(now())

  youtuber           Youtuber?           @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  jobFunction        JobFunction?        @relation(fields: [functionId], references: [id], onDelete: SetNull)
  session            AcademySession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recruitmentSession RecruitmentSession? @relation(fields: [recruitmentSessionId], references: [id], onDelete: Cascade)
  createdBy          Account?            @relation("IntegrationInviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  claims IntegrationClaim[]

  @@index([sessionId])
  @@index([youtuberId])
  @@map("integration_invites")
}

// Discord identity resolved by the server for one link, never sent by the form
model IntegrationClaim {
  id                String    @id @default(cuid())
  inviteId          String
  discordId         String
  discordUsername   String?
  discordAvatarHash String?
  claimedAt         DateTime  @default(now())
  submittedAt       DateTime?
  accountId         String?

  invite  IntegrationInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  account Account?          @relation("IntegrationClaimAccount", fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([inviteId, discordId])
  @@index([discordId])
  @@map("integration_claims")
}

// Moderator holding the trainer seat on a session
model AcademySessionTrainer {
  id        String   @id @default(cuid())
  sessionId String
  accountId String
  createdAt DateTime @default(now())

  session AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account        @relation("AcademyTrainer", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@map("academy_session_trainers")
}

// Junior followed through one session, always an existing moderator
model AcademyJunior {
  id               String              @id @default(cuid())
  sessionId        String
  accountId        String
  trainerId        String?
  // Chosen by the junior on the integration form, empty until then
  dispositifId     String?
  // Application this seat was admitted from
  candidateId      String?             @unique
  // Integration form answered, the pre-generated file confirmed
  confirmedAt      DateTime?
  // PIM start declared by a responsable, opens the integration form
  kickoffAt        DateTime?
  // End of the third period, set by the responsable
  deadlineAt       DateTime?
  // Moments the junior entered each check-in, they bound the review windows of the calendar
  reviewOneDueAt   DateTime?
  reviewFinalDueAt DateTime?
  leftAt           DateTime?
  status           AcademyJuniorStatus @default(ACTIVE)
  stage            AcademyStage        @default(PREPARATION)
  startedAt        DateTime            @default(now())
  validatedAt      DateTime?
  liveCount        Int                 @default(0)
  bonusLives       Int                 @default(0)
  summary          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  session    AcademySession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account    Account               @relation("AcademyJunior", fields: [accountId], references: [id], onDelete: Cascade)
  trainer    Account?              @relation("AcademyJuniorTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  dispositif Dispositif?           @relation(fields: [dispositifId], references: [id], onDelete: Restrict)
  candidate  RecruitmentCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  reviews         AcademyReview[]
  comments        AcademyComment[]
  calendarEvents  CalendarEvent[]
  skills          JuniorSkill[]
  notes           JuniorNote[]
  objectives      JuniorObjective[]
  trainingRecords TrainingRecord[]  @relation("TrainingJunior")

  @@unique([sessionId, accountId])
  @@index([status])
  @@map("academy_juniors")
}

// Competency grade of one junior on one skill of their function/dispositif
model JuniorSkill {
  id          String   @id @default(cuid())
  juniorId    String
  skillId     String
  percent     Int      @default(0)
  validatorId String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  junior    AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  validator Account?      @relation("JuniorSkillValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  @@unique([juniorId, skillId])
  @@map("junior_skills")
}

// Positive or negative trace kept on a junior's FSI
model JuniorNote {
  id        String       @id @default(cuid())
  juniorId  String
  authorId  String?
  stage     AcademyStage
  kind      NoteKind
  body      String
  createdAt DateTime     @default(now())

  junior AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author Account?      @relation("JuniorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([juniorId, createdAt])
  @@map("junior_notes")
}

// Personal objective, unlocked once a junior reaches the practice stage
model JuniorObjective {
  id          String          @id @default(cuid())
  juniorId    String
  authorId    String?
  title       String
  description String?
  dueAt       DateTime?
  status      ObjectiveStatus @default(OPEN)
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  junior AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author Account?      @relation("JuniorObjectiveAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([juniorId, position])
  @@map("junior_objectives")
}

// Remark left on a promotion or on one of its juniors
model AcademyComment {
  id        String   @id @default(cuid())
  sessionId String?
  juniorId  String?
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  session AcademySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  junior  AcademyJunior?  @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author  Account?        @relation("AcademyCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([juniorId, createdAt])
  @@map("academy_comments")
}

// Written trace of one voice check-in held with a junior, and the support of the decision
// that authorises the following stage
model AcademyReview {
  id              String        @id @default(cuid())
  juniorId        String
  authorId        String?
  stage           AcademyStage
  heldAt          DateTime
  durationMinutes Int?
  feeling         String?
  summary         String        @default("")
  advice          ReviewAdvice
  // Outcome the responsable kept, the trainer's advice followed or not
  decision        ReviewAdvice?
  status          ReviewStatus  @default(DRAFT)
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  junior    AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author    Account?      @relation("AcademyReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  decidedBy Account?      @relation("AcademyReviewDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([juniorId, heldAt])
  @@map("academy_reviews")
}

// What a calendar template stands for in the academy, fixed in code
enum EventPurpose {
  TRAINER_INTERVIEW
  PANEL_INTERVIEW
  REVIEW_ONE
  REVIEW_FINAL
}

// Pre-designed entry the calendar form starts from, declared from the admin console
model EventTemplate {
  id              String           @id @default(cuid())
  name            String           @unique
  kind            CalendarKind     @default(EVENT)
  summary         String?
  body            String?
  accent          String?
  visibility      EventVisibility  @default(EVERYONE)
  defaultMinutes  Int?
  purpose         EventPurpose?    @unique
  allDay          Boolean          @default(false)
  // Glyph drawn beside the model
  icon            String?
  // Theme the picker files it under
  category        String?
  // RECRUITMENT or ACADEMY: offered only while such a session runs
  linksTo         String?
  // Length of the slots a model opens, the annual reviews
  slotMinutes     Int?
  // Presence is always asked
  rollCall        Boolean          @default(false)
  // A card on the Réunions page is filed under this audience
  meetingAudience MeetingAudience?
  // A live model opens a live on this platform
  platform        LivePlatform?
  // Function whose team a team meeting convenes
  functionName    String?
  // Weekday (1 = Monday) and wall clock a model proposes
  weekday         Int?
  startTime       String?
  position        Int              @default(0)
  archived        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  events CalendarEvent[]

  @@index([archived])
  @@index([kind])
  @@map("event_templates")
}

// Anything planned on the shared calendar
model CalendarEvent {
  id                String           @id @default(cuid())
  title             String
  emoji             String?
  description       String?
  kind              CalendarKind     @default(EVENT)
  templateId        String?
  accent            String?
  ownerId           String?
  accountId         String?
  youtuberId        String?
  projectId         String?
  meetingId         String?
  sessionId         String?
  juniorId          String?
  trainerId         String?
  startsAt          DateTime
  endsAt            DateTime?
  allDay            Boolean          @default(false)
  visibility        EventVisibility?
  // Team or promotion an audience-bound entry is shown to
  audienceTeamId    String?
  audienceSessionId String?
  audienceLeadsOnly Boolean          @default(false)
  rollCall          Boolean          @default(false)
  rosterShared      Boolean          @default(false)
  rollCallTeamIds   String[]         @default([])
  remindAt          DateTime?
  remindedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attendances EventAttendance[]
  live        Live?

  template EventTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  owner    Account?        @relation("CalendarOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  subject  Account?        @relation("CalendarSubject", fields: [accountId], references: [id], onDelete: Cascade)
  youtuber Youtuber?       @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting  Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  session  AcademySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  junior   AcademyJunior?  @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  trainer  Account?        @relation("CalendarTrainer", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([kind, startsAt])
  @@index([templateId])
  @@index([juniorId])
  @@index([trainerId])
  @@index([ownerId])
  @@index([accountId])
  @@index([rollCall, remindAt, remindedAt])
  @@map("calendar_events")
}

// One member's answer to a roll-call event
model EventAttendance {
  id            String           @id @default(cuid())
  eventId       String
  accountId     String
  status        AttendanceStatus @default(PENDING)
  respondedAt   DateTime?
  // Hours a present moderator expects to be available
  availableFrom DateTime?
  availableTo   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([eventId, accountId])
  @@index([accountId, status])
  @@map("event_attendances")
}

// Alert tier, lower level means tighter moderation
model LiveconLevel {
  id         String   @id @default(cuid())
  level      Int      @unique
  name       String
  // Glyph key drawn wherever the level shows
  icon       String?
  summary    String?
  guidelines String?
  accent     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entries           LiveconEntry[]
  sanctionTiers     SanctionTier[]
  sanctionGravities SanctionOffenseLevel[]

  @@map("livecon_levels")
}

// Recorded switch to a livecon level
model LiveconEntry {
  id         String    @id @default(cuid())
  levelId    String
  youtuberId String?
  // Live the level was in force on
  liveId     String?
  actorId    String?
  reason     String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  level    LiveconLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  youtuber Youtuber?    @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  actor    Account?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  live     Live?        @relation(fields: [liveId], references: [id], onDelete: SetNull)

  @@index([youtuberId, startedAt])
  @@index([endedAt])
  @@index([liveId])
  @@map("livecon_entries")
}

// Discord identifier Memora knows, typed and named, collected or entered by hand
model DiscordIdentifier {
  id         String        @id @default(cuid())
  discordId  String        @unique
  kind       DiscordIdKind
  name       String
  // Creator a role or channel belongs to
  youtuberId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  youtuber Youtuber? @relation(fields: [youtuberId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([youtuberId])
  @@map("discord_identifiers")
}

// Channel a creator streams on, several per platform
model YoutuberChannel {
  id          String       @id @default(cuid())
  youtuberId  String
  platform    LivePlatform
  // Platform user or channel identifier
  externalId  String
  login       String?
  displayName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  youtuber Youtuber @relation(fields: [youtuberId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([youtuberId])
  @@map("youtuber_channels")
}

// One live on one platform, announced by a responsable
model Live {
  id               String       @id @default(cuid())
  youtuberId       String
  platform         LivePlatform
  title            String
  status           LiveStatus   @default(ANNOUNCED)
  plannedStartAt   DateTime
  plannedEndAt     DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  announcedById    String?
  streamExternalId String?
  // YouTube chat handle
  liveChatId       String?
  // Instructions the responsables leave for the team, markdown
  instructions     String       @default("")
  calendarEventId  String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  youtuber       Youtuber           @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  announcedBy    Account?           @relation("LiveAnnouncer", fields: [announcedById], references: [id], onDelete: SetNull)
  calendarEvent  CalendarEvent?     @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  members        LiveMember[]
  coordinations  LiveCoordination[]
  liveconEntries LiveconEntry[]
  actions        ModerationAction[]
  presences      ModViewPresence[]
  stints         LiveModStint[]
  focuses        ModViewFocus[]
  samples        LiveSample[]

  @@unique([platform, streamExternalId])
  @@index([status])
  @@index([youtuberId, plannedStartAt])
  @@map("lives")
}

// Member asked to coordinate a live over a window of their choosing
model LiveCoordination {
  id          String             @id @default(cuid())
  liveId      String
  accountId   String
  status      CoordinationStatus @default(ASKED)
  // Window the member agreed to, empty until they accept
  startsAt    DateTime?
  endsAt      DateTime?
  askedAt     DateTime           @default(now())
  respondedAt DateTime?

  live    Live    @relation(fields: [liveId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([liveId, accountId])
  @@index([accountId, status])
  @@map("live_coordinations")
}

// Member called on one live
model LiveMember {
  liveId        String
  accountId     String
  convokedAt    DateTime @default(now())
  // Added by a Responsable on the day, from outside the creator's team
  reinforcement Boolean  @default(false)
  // Responsable who asked for the reinforcement
  requestedById String?

  live    Live    @relation(fields: [liveId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([liveId, accountId])
  @@index([accountId])
  @@map("live_members")
}

// One moderation gesture on a live, from Memora or straight on the platform
model ModerationAction {
  id                   String           @id @default(cuid())
  liveId               String
  platform             LivePlatform
  // Memora member, none when the gesture came from an unlinked account
  actorAccountId       String?
  actorPlatformUserId  String?
  actorLogin           String?
  targetPlatformUserId String?
  targetLogin          String?
  kind                 ModerationKind
  durationSeconds      Int?
  reason               String?
  // Livecon level in force at the time
  liveconLevel         Int?
  messageExcerpt       String?
  // Panel offence and rung the gesture applied, none when made by hand
  offenseId            String?
  rung                 Int?
  // Member followed in Focus mode, the gesture made in their place
  onBehalfOfId         String?
  origin               ModerationOrigin
  status               ModerationStatus @default(PENDING)
  errorCode            String?
  idempotencyKey       String?          @unique
  externalEventId      String?
  occurredAt           DateTime         @default(now())
  createdAt            DateTime         @default(now())

  live       Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  actor      Account? @relation("ModerationActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  onBehalfOf Account? @relation("ModerationOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)

  @@unique([platform, externalEventId])
  @@index([actorAccountId, occurredAt])
  @@index([liveId, occurredAt])
  @@index([targetPlatformUserId, occurredAt])
  @@index([kind])
  @@map("moderation_actions")
}

// Time a member spent in the Mod View of a live, counted from heartbeats
model ModViewPresence {
  id             String               @id @default(cuid())
  accountId      String
  liveId         String
  openedAt       DateTime             @default(now())
  lastBeatAt     DateTime             @default(now())
  closedAt       DateTime?
  visibleSeconds Int                  @default(0)
  activeSeconds  Int                  @default(0)
  closeReason    PresenceCloseReason?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  live    Live    @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId, accountId])
  @@index([accountId, openedAt])
  @@map("modview_presences")
}

// Stretch a member moderated a live, open until they say they stop or the live ends
model LiveModStint {
  id        String    @id @default(cuid())
  liveId    String
  accountId String
  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  live    Live    @relation(fields: [liveId], references: [id], onDelete: Cascade)
  account Account @relation("ModStintAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([liveId, accountId])
  @@index([accountId, startedAt])
  @@map("live_mod_stints")
}

// Private comment a member leaves on a viewer of a creator's channel
model ViewerComment {
  id              String       @id @default(cuid())
  youtuberId      String
  platform        LivePlatform
  // Platform user identifier of the viewer
  platformUserId  String
  viewerLogin     String
  authorAccountId String?
  // Encrypted at rest
  body            String
  createdAt       DateTime     @default(now())

  youtuber Youtuber @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  author   Account? @relation("ViewerCommentAuthor", fields: [authorAccountId], references: [id], onDelete: SetNull)

  @@index([youtuberId, platform, platformUserId, createdAt], map: "viewer_comments_viewer_idx")
  @@map("viewer_comments")
}

// Viewer count read from the platform while a live runs
model LiveSample {
  id      String   @id @default(cuid())
  liveId  String
  at      DateTime @default(now())
  viewers Int

  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId, at])
  @@map("live_samples")
}

// One member following another's gestures live, Focus mode
model ModViewFocus {
  id        String    @id @default(cuid())
  liveId    String
  watcherId String
  targetId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  live    Live    @relation(fields: [liveId], references: [id], onDelete: Cascade)
  watcher Account @relation("FocusWatcher", fields: [watcherId], references: [id], onDelete: Cascade)
  target  Account @relation("FocusTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([liveId, endedAt])
  @@index([watcherId])
  @@map("modview_focuses")
}

// Platform grant of one member, both tokens encrypted at rest
model PlatformAccount {
  id             String       @id @default(cuid())
  accountId      String
  platform       LivePlatform
  externalUserId String
  login          String
  displayName    String?
  scopes         String[]     @default([])
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  // Set once the platform refuses the refresh
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, platform])
  @@unique([platform, externalUserId])
  @@index([expiresAt])
  @@map("platform_accounts")
}

// Trace of a fact worth keeping
model ActivityLog {
  id         String   @id @default(cuid())
  eventType  Int
  origin     Int      @default(0)
  actorId    String?
  subjectId  String?
  targetType String?
  targetId   String?
  summary    String
  payload    Json?
  // 0 info, 1 warning, 2 error
  level      Int      @default(0)
  // Where the request came from
  ip         String?
  userAgent  String?
  route      String?
  createdAt  DateTime @default(now())

  actor   Account? @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject Account? @relation("LogSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([subjectId, createdAt])
  @@index([targetType, targetId])
  @@index([eventType])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([level, createdAt])
  @@map("activity_logs")
}

// Personal alert addressed to one member, kind comes from NOTIFICATION_KINDS
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  actorId     String?
  kind        Int
  targetType  String?
  targetId    String?
  subject     String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient  Account        @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor      Account?       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  deliveries PushDelivery[]

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

// Backing table of StorageManager, bucket comes from STORAGE_BUCKETS
model StorageEntry {
  id        String   @id @default(cuid())
  bucket    String
  key       String
  mimeType  String
  byteSize  Int
  data      Bytes
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bucket, key])
  @@index([bucket])
  @@map("storage_entries")
}

// Nature of a sanction measure
enum SanctionKind {
  DELETE
  WARN
  TIMEOUT
  BAN
  NONE
  COMMENT
  REPORT
}

// Surface a panel moderates, each with its own tools and commands
enum SanctionPanel {
  TWITCH
  YOUTUBE
  DISCORD
}

// Weight of an offence inside one livecon level
enum SanctionGravity {
  LOW
  MEDIUM
  HIGH
}

// Measure applied at one offence tier
model SanctionMeasure {
  id              String       @id @default(cuid())
  name            String       @unique
  kind            SanctionKind @default(TIMEOUT)
  durationMinutes Int?
  permanent       Boolean      @default(false)
  weight          Int          @default(0)
  accent          String?
  position        Int          @default(0)
  archived        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tiers SanctionTierMeasure[]

  @@index([weight])
  @@map("sanction_measures")
}

// Offence listed on one creator panel
model SanctionOffense {
  id               String        @id @default(cuid())
  youtuberId       String
  panel            SanctionPanel @default(TWITCH)
  name             String
  summary          String?
  // One case per line
  example          String?
  // What looks close but is left alone, one case per line
  toleratedExample String?
  warningExample   String?
  // Words the Mod View suggestion looks for, one per line
  keywords         String?
  accent           String?
  position         Int           @default(0)
  archived         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  youtuber Youtuber               @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  tiers    SanctionTier[]
  levels   SanctionOffenseLevel[]

  @@unique([youtuberId, panel, name])
  @@index([youtuberId, panel, position])
  @@map("sanction_offenses")
}

// Gravity of one offence inside one livecon level
model SanctionOffenseLevel {
  id        String          @id @default(cuid())
  offenseId String
  levelId   String
  gravity   SanctionGravity @default(LOW)

  offense SanctionOffense @relation(fields: [offenseId], references: [id], onDelete: Cascade)
  level   LiveconLevel    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([offenseId, levelId])
  @@index([levelId])
  @@map("sanction_offense_levels")
}

// Graduated step of one offence inside one livecon panel, its condition naming when it applies
model SanctionTier {
  id        String  @id @default(cuid())
  offenseId String
  levelId   String
  step      Int
  // Condition, « Dès constaté », « Si récidive »...
  note      String?

  offense  SanctionOffense       @relation(fields: [offenseId], references: [id], onDelete: Cascade)
  level    LiveconLevel          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  measures SanctionTierMeasure[]

  @@unique([offenseId, levelId, step])
  @@index([levelId])
  @@map("sanction_tiers")
}

// Measure applied together with the others of one step
model SanctionTierMeasure {
  tierId    String
  measureId String
  position  Int    @default(0)

  tier    SanctionTier    @relation(fields: [tierId], references: [id], onDelete: Cascade)
  measure SanctionMeasure @relation(fields: [measureId], references: [id], onDelete: Restrict)

  @@id([tierId, measureId])
  @@index([measureId])
  @@map("sanction_tier_measures")
}

// Phase a recruitment campaign sits in
enum RecruitmentStatus {
  DRAFT
  ANNOUNCED
  INTERVIEWS
  CLOSED
  ARCHIVED
}

// Platform an interview script is written for
enum RecruitmentPlatform {
  DISCORD
  TWITCH
}

// Recruiter's reaction to an answer
enum AnswerAppreciation {
  LIKE
  NEUTRAL
  DISLIKE
}

// Who carries out a recruitment timeline step
enum RecruitmentOwner {
  RESPONSABLE
  RECRUTEURS
  BOTH
}

// Campaign opened for one creator and one function, announced outside then held on Discord
model RecruitmentSession {
  id               String              @id @default(cuid())
  youtuberId       String
  functionId       String
  academySessionId String?             @unique
  name             String
  status           RecruitmentStatus   @default(DRAFT)
  summary          String?
  instructions     String              @default("")
  platform         RecruitmentPlatform @default(DISCORD)
  // Keys of the questions the recruiters picked, in asking order
  questionKeys     String[]            @default([])
  opensAt          DateTime?
  closesAt         DateTime?
  // Discord wording posted for the interviews, once announced
  announcement     String?
  announcedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  youtuber       Youtuber                 @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  jobFunction    JobFunction              @relation(fields: [functionId], references: [id], onDelete: Restrict)
  academySession AcademySession?          @relation(fields: [academySessionId], references: [id], onDelete: SetNull)
  candidates     RecruitmentCandidate[]
  bans           RecruitmentBan[]
  comments       RecruitmentComment[]
  steps          RecruitmentStep[]
  responsables   RecruitmentResponsable[]
  recruiters     RecruitmentRecruiter[]
  observers      RecruitmentObserver[]
  invite         IntegrationInvite?
  project        Project?

  @@unique([youtuberId, functionId, name])
  @@index([youtuberId, status])
  @@index([functionId])
  @@map("recruitment_sessions")
}

// Moderator carrying a recruitment session
model RecruitmentResponsable {
  id        String   @id @default(cuid())
  sessionId String
  accountId String
  createdAt DateTime @default(now())

  session RecruitmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account            @relation("RecruitmentResponsable", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@index([accountId])
  @@map("recruitment_responsables")
}

// Moderator leading the interviews of a recruitment session
model RecruitmentRecruiter {
  id        String   @id @default(cuid())
  sessionId String
  accountId String
  createdAt DateTime @default(now())

  session RecruitmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account            @relation("RecruitmentRecruiter", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@index([accountId])
  @@map("recruitment_recruiters")
}

// Temporary member who may sit in on a few interviews of one session, never edit it
model RecruitmentObserver {
  id        String   @id @default(cuid())
  sessionId String
  accountId String
  createdAt DateTime @default(now())

  session RecruitmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account            @relation("RecruitmentObserver", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@index([accountId])
  @@map("recruitment_observers")
}

// Applicant of one campaign, held by their Discord identifier and never given an account
model RecruitmentCandidate {
  id                 String    @id @default(cuid())
  sessionId          String
  discordId          String
  // Pseudonym known at application time, seeds the pre-generated file
  displayName        String?
  formId             String?
  recruiterId        String?
  outcomeId          String?
  interviewAt        DateTime?
  attended           Boolean   @default(false)
  // Questions read with « vous », switched by the recruiter during the interview
  formal             Boolean   @default(true)
  // Interview opened by a recruiter
  interviewStartedAt DateTime?
  // Interview closed by its recruiter
  interviewEndedAt   DateTime?
  // Verdict given, the interview is over
  verdictAt          DateTime?
  review             String    @default("")
  // Timeline moments ticked or unticked by hand, by moment key
  stageMarks         Json      @default("{}")
  position           Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  session    RecruitmentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recruiter  Account?             @relation("RecruitmentRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  outcome    RecruitmentOutcome?  @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  recruiters CandidateRecruiter[]
  observers  RecruitmentSeat[]
  comments   RecruitmentComment[]
  exercises  ExerciseLink[]
  answers    RecruitmentAnswer[]
  admission  AcademyJunior?

  @@unique([sessionId, discordId])
  @@index([discordId])
  @@index([outcomeId, position])
  @@map("recruitment_candidates")
}

// Discord identity barred from every future recruitment session
model RecruitmentBan {
  id          String   @id @default(cuid())
  discordId   String   @unique
  // Session the ban was decided on, kept when the session goes
  sessionId   String?
  // Name known when banned, the candidacy itself may be purged
  displayName String?
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  session   RecruitmentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy Account?            @relation("RecruitmentBanAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("recruitment_bans")
}

// Moderator leading the interview of one candidate, several may share it
model CandidateRecruiter {
  candidateId String
  accountId   String
  createdAt   DateTime @default(now())

  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  account   Account              @relation("CandidateRecruiter", fields: [accountId], references: [id], onDelete: Cascade)

  @@id([candidateId, accountId])
  @@index([accountId])
  @@map("candidate_recruiters")
}

// Moderator sitting in on one interview without leading it
model RecruitmentSeat {
  candidateId String
  accountId   String

  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  account   Account              @relation("RecruitmentSeat", fields: [accountId], references: [id], onDelete: Cascade)

  @@id([candidateId, accountId])
  @@index([accountId])
  @@map("recruitment_seats")
}

// Temporary link handing one written context to one candidate, readable by their Discord identity only
model ExerciseLink {
  id          String    @id @default(cuid())
  candidateId String
  token       String    @unique
  // Context of the code-declared bank
  contextKey  String
  // Secret held by the browser that proved the identity
  claimToken  String?
  claimedAt   DateTime?
  plays       Int       @default(0)
  expiresAt   DateTime
  // Cut short by the recruiter
  expiredAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy Account?             @relation("ExerciseLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@map("exercise_links")
}

// What the recruiter noted on one question of the script while interviewing a candidate
model RecruitmentAnswer {
  id           String              @id @default(cuid())
  candidateId  String
  // Key of the question in the code-declared bank
  questionKey  String
  // Branch the recruiter unfolded, the others read as skipped
  branch       String?
  appreciation AnswerAppreciation?
  skipped      Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, questionKey])
  @@map("recruitment_answers")
}

// Remark left on a project, a task, a communication or a meeting
model WorkComment {
  id              String   @id @default(cuid())
  projectId       String?
  taskId          String?
  communicationId String?
  meetingId       String?
  authorId        String?
  body            String
  createdAt       DateTime @default(now())

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author        Account?       @relation("WorkCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([communicationId, createdAt])
  @@index([meetingId, createdAt])
  @@map("work_comments")
}

// Remark left on a candidate while their application is being weighed
model RecruitmentComment {
  id          String    @id @default(cuid())
  // Either an application, or a whole session when none
  candidateId String?
  sessionId   String?
  authorId    String?
  body        String
  // Question of the bank the remark was left under, none for a free remark
  questionKey String?
  // Pinned on the candidate rail
  pinnedAt    DateTime?
  createdAt   DateTime  @default(now())

  candidate RecruitmentCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  session   RecruitmentSession?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author    Account?              @relation("RecruitmentCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([candidateId, questionKey])
  @@index([sessionId, createdAt])
  @@map("recruitment_comments")
}

// Column of the results board, declared from the admin console
model RecruitmentOutcome {
  id         String   @id @default(cuid())
  name       String   @unique
  accent     String?
  position   Int      @default(0)
  isDefault  Boolean  @default(false)
  isTerminal Boolean  @default(false)
  // Landing here admits the candidate into the promotion
  admits     Boolean  @default(false)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  candidates RecruitmentCandidate[]

  @@index([position])
  @@map("recruitment_outcomes")
}

// Question of the interview script, narrowed to the creators and functions it fits
model RecruitmentQuestion {
  id         String   @id @default(cuid())
  prompt     String
  hint       String?
  youtuberId String?
  functionId String?
  position   Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  youtuber    Youtuber?    @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  jobFunction JobFunction? @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@index([position])
  @@index([youtuberId, functionId])
  @@map("recruitment_questions")
}

// Trame of timeline steps a campaign instantiates when it is created
model RecruitmentStepTemplate {
  id          String           @id @default(cuid())
  title       String
  description String?
  youtuberId  String?
  functionId  String?
  offset      Int              @default(0)
  owner       RecruitmentOwner @default(RESPONSABLE)
  required    Boolean          @default(false)
  archived    Boolean          @default(false)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  youtuber    Youtuber?         @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  jobFunction JobFunction?      @relation(fields: [functionId], references: [id], onDelete: Cascade)
  steps       RecruitmentStep[]

  @@index([position])
  @@index([youtuberId, functionId])
  @@map("recruitment_step_templates")
}

// Moment of one campaign timeline, instantiated from the trame then tended by hand
model RecruitmentStep {
  id          String           @id @default(cuid())
  sessionId   String
  templateId  String?
  title       String
  notes       String?
  owner       RecruitmentOwner @default(RESPONSABLE)
  offset      Int              @default(0)
  scheduledAt DateTime?
  doneAt      DateTime?
  required    Boolean          @default(false)
  emitsInvite Boolean          @default(false)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  session  RecruitmentSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  template RecruitmentStepTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([sessionId, position])
  @@map("recruitment_steps")
}

// Where a Legacy track stands
enum LegacyStatus {
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

// Training of a moderator toward the Responsable role, led on the trade they already work
model LegacyTrack {
  id          String       @id @default(cuid())
  accountId   String
  // Trade the future Responsable will lead, deciding which modules they follow
  functionId  String?
  startsAt    DateTime
  endsAt      DateTime
  status      LegacyStatus @default(RUNNING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  account     Account      @relation("LegacyMember", fields: [accountId], references: [id], onDelete: Cascade)
  jobFunction JobFunction? @relation(fields: [functionId], references: [id], onDelete: SetNull)
  decidedBy   Account?     @relation("LegacyDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  results LegacyModuleResult[]

  @@index([accountId, status])
  @@index([status, endsAt])
  @@map("legacy_tracks")
}

// One module of a Legacy track: what the exercises earned, what the evaluator gave, the total
model LegacyModuleResult {
  id             String    @id @default(cuid())
  trackId        String
  moduleKey      String
  // Saved exercises, same shape as an interactive course
  progress       Json?
  autoScore      Int       @default(0)
  evaluatorScore Int?
  total          Int       @default(0)
  passed         Boolean   @default(false)
  gradedById     String?
  gradedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  track    LegacyTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  gradedBy Account?    @relation("LegacyGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([trackId, moduleKey])
  @@map("legacy_module_results")
}

// Games of Memora Play
enum PlayGame {
  BACCALAUREAT
  GOLF
  BOMB
  LUDO
}

// Life of a game or a tournament
enum PlaySessionStatus {
  LOBBY
  RUNNING
  FINISHED
  ABANDONED
}

// How a player ended a game
enum PlayOutcome {
  WIN
  DRAW
  LOSS
}

// Several games chained under one cumulated ranking
model PlayTournament {
  id         String            @id @default(cuid())
  game       PlayGame
  hostId     String
  gamesCount Int
  status     PlaySessionStatus @default(RUNNING)
  finishedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  host     Account       @relation("PlayTournamentHost", fields: [hostId], references: [id], onDelete: Cascade)
  sessions PlaySession[]

  @@map("play_tournaments")
}

// One game, from its lobby to its end
model PlaySession {
  id              String            @id @default(cuid())
  game            PlayGame
  status          PlaySessionStatus @default(LOBBY)
  hostId          String
  tournamentId    String?
  tournamentIndex Int?
  // Game this one replays with the same table
  rematchOfId     String?           @unique
  // Choices of the host, shaped by the game
  settings        Json
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  host        Account             @relation("PlaySessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  tournament  PlayTournament?     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rematchOf   PlaySession?        @relation("PlayRematch", fields: [rematchOfId], references: [id], onDelete: SetNull)
  rematch     PlaySession?        @relation("PlayRematch")
  seats       PlaySeat[]
  bacRounds   BaccalaureatRound[]
  bombGame    BombGame?
  bombSeats   BombPlayer[]
  bombMoves   BombMove[]
  golfGame    GolfGame?
  golfPlayers GolfPlayer[]
  golfMoves   GolfMove[]
  ludoGame    LudoGame?
  ludoPlayers LudoPlayer[]
  ludoMoves   LudoMove[]
  messages    PlayMessage[]
  invites     PlayInvite[]

  @@index([status, game])
  @@index([tournamentId, tournamentIndex])
  @@map("play_sessions")
}

// A player's place in a game, kept until they leave on purpose
model PlaySeat {
  id        String       @id @default(cuid())
  sessionId String
  accountId String
  color     String
  score     Int          @default(0)
  rank      Int?
  outcome   PlayOutcome?
  xp        Int          @default(0)
  joinedAt  DateTime     @default(now())
  leftAt    DateTime?
  kickedAt  DateTime?

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@index([accountId, leftAt])
  @@map("play_seats")
}

// What a chat line says: a written text, or a table event
enum PlayMessageKind {
  TEXT
  JOINED
  LEFT
  KICKED
}

// Line of a game chat, written by a player or posted by the table
model PlayMessage {
  id        String          @id @default(cuid())
  sessionId String
  accountId String
  kind      PlayMessageKind @default(TEXT)
  body      String
  createdAt DateTime        @default(now())

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("play_messages")
}

// Seat offered at a game
enum PlayInviteRole {
  PLAYER
  SPECTATOR
}

// Someone called to a game, as a player or to watch
model PlayInvite {
  id         String         @id @default(cuid())
  sessionId  String
  inviterId  String
  // Null calls all of Memora
  inviteeId  String?
  role       PlayInviteRole
  answeredAt DateTime?
  createdAt  DateTime       @default(now())

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inviter Account     @relation("PlayInviteFrom", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee Account?    @relation("PlayInviteTo", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, inviteeId])
  @@index([inviteeId, answeredAt])
  @@map("play_invites")
}

// Totals of one player on one game, the global ones are their sum
model PlayGameStat {
  id                String   @id @default(cuid())
  accountId         String
  game              PlayGame
  xp                Int      @default(0)
  played            Int      @default(0)
  wins              Int      @default(0)
  draws             Int      @default(0)
  losses            Int      @default(0)
  abandons          Int      @default(0)
  streak            Int      @default(0)
  bestStreak        Int      @default(0)
  playSeconds       Int      @default(0)
  tournamentsPlayed Int      @default(0)
  tournamentsWon    Int      @default(0)
  // Counters proper to the game
  extra             Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, game])
  @@index([game, xp])
  @@map("play_game_stats")
}

// Global side of a player, outside any game
model PlayProfile {
  accountId String    @id
  // XP given on the global line alone
  bonusXp   Int       @default(0)
  bannedAt  DateTime?
  banReason String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("play_profiles")
}

// One letter of a Baccalaureat game, its phases read from the dates
model BaccalaureatRound {
  id           String    @id @default(cuid())
  sessionId    String
  index        Int
  letter       String
  startsAt     DateTime
  endsAt       DateTime
  stoppedById  String?
  // Player who spent their letter joker here
  rerolledById String?
  // Speed bonus paid to the stopper
  bonus        Int       @default(0)
  closedAt     DateTime?
  reviewEndsAt DateTime?
  scoredAt     DateTime?
  createdAt    DateTime  @default(now())

  session PlaySession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers BaccalaureatAnswer[]

  @@unique([sessionId, index])
  @@map("play_baccalaureat_rounds")
}

// One word written for one category
model BaccalaureatAnswer {
  id        String   @id @default(cuid())
  roundId   String
  accountId String
  category  String
  word      String
  // Null until the review ends
  valid     Boolean?
  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  round   BaccalaureatRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  account Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  votes   BaccalaureatVote[]

  @@unique([roundId, accountId, category])
  @@map("play_baccalaureat_answers")
}

// A player's verdict on someone else's word
model BaccalaureatVote {
  id       String  @id @default(cuid())
  answerId String
  voterId  String
  accepted Boolean

  answer BaccalaureatAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  voter  Account            @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([answerId, voterId])
  @@map("play_baccalaureat_votes")
}

// Bomb Party table: the bomb, its prompt and whose turn it is
model BombGame {
  sessionId  String    @id
  prompt     String
  // Turns the prompt survived unsolved
  promptAge  Int       @default(0)
  turnId     String
  startsAt   DateTime
  // Hidden fuse, never sent to players
  explodesAt DateTime
  // What the player on turn is typing
  draft      String    @default("")
  missWord   String?
  missReason String?
  blastAt    DateTime?
  blastId    String?
  updatedAt  DateTime  @updatedAt

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("play_bomb_games")
}

// A player around the bomb, lives and bonus letters
model BombPlayer {
  id           String    @id @default(cuid())
  sessionId    String
  accountId    String
  order        Int
  lives        Int
  // Bonus letters gathered toward the next heart
  letters      String    @default("")
  eliminatedAt DateTime?

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@map("play_bomb_players")
}

// What happened at the table
enum BombMoveKind {
  WORD
  BLAST
  LIFE
}

// One word played, one blast or one heart won
model BombMove {
  id        String       @id @default(cuid())
  sessionId String
  accountId String
  kind      BombMoveKind
  // Comparable form, once per game
  word      String?
  prompt    String
  createdAt DateTime     @default(now())

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, word])
  @@index([sessionId, createdAt])
  @@map("play_bomb_moves")
}

// Golf table: the hole in play, its clock and what lies on the course
model GolfGame {
  sessionId String    @id
  hole      Int       @default(0)
  // Strokes open from then
  startsAt  DateTime
  endsAt    DateTime
  // Hole over, scorecard on screen
  closedAt  DateTime?
  // Server ms each orb comes back
  orbs      Json      @default("[]")
  // Bumpers and tornados laid by players
  hazards   Json      @default("[]")
  // Bumped on every move, the newest board wins
  rev       Int       @default(0)
  updatedAt DateTime  @updatedAt

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("play_golf_games")
}

// A ball on the course, its card and its powers
model GolfPlayer {
  id        String    @id @default(cuid())
  sessionId String
  accountId String
  x         Float
  z         Float
  // Still rolling until then
  restsAt   DateTime
  strokes   Int       @default(0)
  holedAt   DateTime?
  // Strokes of each finished hole
  card      Int[]     @default([])
  // Powers in hand, oldest first
  powers    String[]  @default([])
  effects   Json      @default("[]")

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@map("play_golf_players")
}

// What happened on the course
enum GolfMoveKind {
  SHOT
  HOLED
  POWER
  FALL
}

// A stroke and its tracks, a ball holed, a power played or a fall
model GolfMove {
  id        String       @id @default(cuid())
  sessionId String
  accountId String
  kind      GolfMoveKind
  hole      Int
  // Strokes once holed
  strokes   Int?
  power     String?
  // Tracks of a stroke, replayed by every screen
  path      Json?
  createdAt DateTime     @default(now())

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, kind])
  @@map("play_golf_moves")
}

// Ludo table: whose turn, the die on the table and the turn clock
model LudoGame {
  sessionId  String   @id
  turnId     String
  // Die waiting for a pawn, null before the roll
  dice       Int?
  // Sixes in a row this turn
  sixes      Int      @default(0)
  startsAt   DateTime
  turnEndsAt DateTime
  // Bumped on every move, the newest board wins
  rev        Int      @default(0)
  updatedAt  DateTime @updatedAt

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("play_ludo_games")
}

// A colour at the table and its pawns
model LudoPlayer {
  id         String    @id @default(cuid())
  sessionId  String
  accountId  String
  // Board corner, clockwise from top left
  corner     Int
  // Steps of each pawn, -1 in the yard
  pawns      Int[]
  finishedAt DateTime?
  place      Int?

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@map("play_ludo_players")
}

// What happened on the board
enum LudoMoveKind {
  ROLL
  MOVE
  CAPTURE
  HOME
  SKIP
  PENALTY
  FINISH
}

// One roll, one pawn moved or one pawn sent back
model LudoMove {
  id        String       @id @default(cuid())
  sessionId String
  accountId String
  kind      LudoMoveKind
  // Board revision it belongs to
  rev       Int
  dice      Int?
  pawn      Int?
  from      Int?
  to        Int?
  // Player whose pawn was taken
  victimId  String?
  createdAt DateTime     @default(now())

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([sessionId, rev])
  @@map("play_ludo_moves")
}

// Level a share hands out, the owner stands above all of them
enum PageAccessLevel {
  FULL
  EDIT
  COMMENT
  VIEW
}

// Who a share reaches: every member, one hierarchy level, or one account
enum PageShareScope {
  WORKSPACE
  ROLE
  ACCOUNT
}

// Private page of the block editor, readable by its owner and its shares only
model Page {
  // Random v4, never guessable from another id
  id            String    @id @default(uuid())
  ownerId       String
  parentId      String?
  title         String    @default("")
  // One emoji
  icon          String?
  coverMediaId  String?
  // Validated block document, see src/core/lib/pages/document.ts
  content       Json
  // Plain text of the content, read by search only
  searchText    String    @default("")
  // Bumped on every content save, the base of conflict detection
  version       Int       @default(1)
  // Order among siblings
  position      Int       @default(0)
  // Shares of the parent page reach this one
  inheritAccess Boolean   @default(true)
  trashedAt     DateTime?
  trashedById   String?
  // Page whose removal swept this one along, restored together
  trashRootId   String?
  editedById    String?
  contentAt     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner     Account        @relation("PageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  editor    Account?       @relation("PageEditor", fields: [editedById], references: [id], onDelete: SetNull)
  parent    Page?          @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]         @relation("PageTree")
  grants    PageGrant[]
  media     PageMedia[]
  revisions PageRevision[]
  comments  PageComment[]

  @@index([ownerId, trashedAt])
  @@index([parentId, position])
  @@index([trashRootId])
  @@map("pages")
}

// One share of a page; targetKey keeps a single row per audience
model PageGrant {
  id          String          @id @default(cuid())
  pageId      String
  scope       PageShareScope
  accountId   String?
  role        MemberRole?
  level       PageAccessLevel
  // workspace, role:<ROLE> or account:<id>
  targetKey   String
  grantedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  account   Account? @relation("PageGrantAccount", fields: [accountId], references: [id], onDelete: Cascade)
  grantedBy Account? @relation("PageGrantAuthor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([pageId, targetKey])
  @@index([accountId])
  @@index([scope, role])
  @@map("page_grants")
}

// Picture held by a page, served only to who may read the page
model PageMedia {
  id             String   @id @default(uuid())
  pageId         String
  storageEntryId String   @unique
  uploadedById   String?
  createdAt      DateTime @default(now())

  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  uploadedBy Account? @relation("PageMediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@map("page_media")
}

// Snapshot kept for the coming history view
model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  version   Int
  title     String
  content   Json
  authorId  String?
  createdAt DateTime @default(now())

  page   Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author Account? @relation("PageRevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@map("page_revisions")
}

// Remark on a page, optionally pinned to one block
model PageComment {
  id         String    @id @default(cuid())
  pageId     String
  blockId    String?
  authorId   String?
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  page   Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author Account? @relation("PageCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@map("page_comments")
}
