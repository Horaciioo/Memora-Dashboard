generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Hierarchy level, drives the permission matrix
enum MemberRole {
  ADMIN
  RESPONSABLE
  MODERATEUR
}

// Lifecycle of a member inside the organisation
enum MemberStatus {
  ACADEMY
  ACTIVE
  PAUSED
  LEFT
}

// Academy period a training belongs to
enum AcademyPeriod {
  DISCOVERY
  PRACTICE
}

// Lifecycle of a session
enum AcademySessionStatus {
  DRAFT
  OPEN
  RUNNING
  CLOSED
  ARCHIVED
}

// Outcome of a junior inside a session
enum AcademyJuniorStatus {
  ACTIVE
  VALIDATED
  STOPPED
}

// Kind of step recorded on the session timeline
enum AcademyStepKind {
  FORMATION
  BILAN_VOCAL
  ENTREVUE
  POINT_RESPONSABLE
  SESSION_TRAVAIL
}

// Broad phase of a junior's PIM, drives which timeline steps are open
enum AcademyStage {
  PREPARATION
  DISCOVERY
  REVIEW_ONE
  PRACTICE
  REVIEW_FINAL
  BONUS
}

// How a timeline step's due date is computed
enum StepAnchor {
  DAY
  LIVE
}

// Who is responsible for carrying out a timeline step
enum StepOwner {
  RESPONSABLE
  FORMATEURS
  BOTH
  JUNIOR
}

// Kind of trace kept on a junior's FSI
enum NoteKind {
  POSITIVE
  NEGATIVE
}

// Outcome of a junior's personal objective
enum ObjectiveStatus {
  OPEN
  REACHED
  MISSED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ABANDONED
}

// Outcome a Formateur proposes at the end of a voice check-in
enum ReviewAdvice {
  PASS
  BONUS
  STOP
}

// Lifecycle of a voice check-in
enum ReviewStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  REJECTED
}

// Surface a workflow state belongs to
enum WorkflowScope {
  PROJECT
  TASK
  MEETING
}

// Role held inside a meeting
enum AttendeeKind {
  LEAD
  ASSISTANT
  PARTICIPANT
}

// Review outcome of an absence request
enum AbsenceStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

// Whether a function is held as main or secondary
enum FunctionKind {
  PRIMARY
  SECONDARY
}

// Whether an account permission is granted or taken away
enum PermissionEffect {
  ALLOW
  DENY
}

// Shape a calendar entry takes on the grid, never editable from the console
enum CalendarKind {
  ZONE
  PERIOD
  EVENT
}

// Who a calendar entry is shown to
enum EventVisibility {
  EVERYONE
  RESPONSABLES
  ADMINS
}

// Signed-in member
model Account {
  id                  String       @id @default(cuid())
  discordId           String       @unique
  displayName         String
  email               String?
  phone               String?
  birthday            DateTime?
  celebrateBirthday   Boolean      @default(true)
  joinedAt            DateTime     @default(now())
  leftAt              DateTime?
  languages           String[]     @default([])
  timezone            String?
  avatarUrl           String?
  role                MemberRole   @default(MODERATEUR)
  status              MemberStatus @default(ACADEMY)
  divisionId          String?
  primaryFunctionId   String?
  secondaryFunctionId String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  division          Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  youtubers         Youtuber[]
  primaryFunction   JobFunction? @relation("PrimaryFunction", fields: [primaryFunctionId], references: [id], onDelete: SetNull)
  secondaryFunction JobFunction? @relation("SecondaryFunction", fields: [secondaryFunctionId], references: [id], onDelete: SetNull)

  sessions              Session[]
  permissions           AccountPermission[]
  socialLinks           SocialLink[]
  calendarEntries       CalendarEvent[]         @relation("CalendarSubject")
  absences              Absence[]               @relation("AbsenceOwner")
  reviewedAbsences      Absence[]               @relation("AbsenceReviewer")
  notesReceived         AccountNote[]           @relation("NoteSubject")
  notesWritten          AccountNote[]           @relation("NoteAuthor")
  trainingRecords       TrainingRecord[]        @relation("TrainingLearner")
  trainingsValidated    TrainingRecord[]        @relation("TrainingValidator")
  academyJuniors        AcademyJunior[]         @relation("AcademyJunior")
  academyTrainees       AcademyJunior[]         @relation("AcademyJuniorTrainer")
  academySeats          AcademySessionTrainer[] @relation("AcademyTrainer")
  academySteps          AcademyStep[]           @relation("AcademyStepAuthor")
  academyStepsValidated AcademyStep[]           @relation("AcademyStepValidator")
  sessionInvitesCreated SessionInvite[]         @relation("SessionInviteCreatedBy")
  quizAnswers           JuniorAnswer[]
  academyReviews        AcademyReview[]         @relation("AcademyReviewAuthor")
  academyReviewsDecided AcademyReview[]         @relation("AcademyReviewDecider")
  juniorSkillsGraded    JuniorSkill[]           @relation("JuniorSkillValidator")
  juniorNotesWritten    JuniorNote[]            @relation("JuniorNoteAuthor")
  juniorObjectivesSet   JuniorObjective[]       @relation("JuniorObjectiveAuthor")
  calendarEvents        CalendarEvent[]         @relation("CalendarOwner")
  ledTeams              Team[]                  @relation("TeamLead")
  teamMemberships       TeamMember[]
  projectLeads          ProjectLead[]
  projectAssists        ProjectAssistant[]
  ownedTasks            Task[]                  @relation("TaskOwner")
  meetingSeats          MeetingAttendee[]
  projectsOpened        Project[]               @relation("ProjectAuthor")
  projectsEdited        Project[]               @relation("ProjectEditor")
  tasksOpened           Task[]                  @relation("TaskAuthor")
  tasksEdited           Task[]                  @relation("TaskEditor")
  meetingsPlanned       Meeting[]               @relation("MeetingAuthor")
  meetingsEdited        Meeting[]               @relation("MeetingEditor")
  communications        Communication[]
  liveconChanges        LiveconEntry[]
  activityAsSubject     ActivityLog[]           @relation("LogSubject")
  activityAsActor       ActivityLog[]           @relation("LogActor")
  recruitmentInterviews RecruitmentCandidate[]  @relation("RecruitmentRecruiter")
  recruitmentSeats      RecruitmentSpectator[]  @relation("RecruitmentSpectator")
  recruitmentComments   RecruitmentComment[]    @relation("RecruitmentCommentAuthor")

  @@index([role])
  @@index([status])
  @@index([divisionId])
  @@map("accounts")
}

// Signed cookie handle of an open session
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

// Per-account override on top of role and function grants
model AccountPermission {
  id         String           @id @default(cuid())
  accountId  String
  permission String
  effect     PermissionEffect @default(ALLOW)
  createdAt  DateTime         @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, permission])
  @@map("account_permissions")
}

// Permissions attached to a hierarchy level
model RolePermission {
  id         String     @id @default(cuid())
  role       MemberRole
  permission String

  @@unique([role, permission])
  @@map("role_permissions")
}

// Permission batch already landed, keeping every later sync purely additive
model GrantMigration {
  key       String   @id
  appliedAt DateTime @default(now())

  @@map("grant_migrations")
}

// Extra permissions carried by a moderation function
model FunctionPermission {
  id         String @id @default(cuid())
  functionId String
  permission String

  jobFunction JobFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([functionId, permission])
  @@map("function_permissions")
}

// Creator whose community the work is done for
model Youtuber {
  id        String   @id @default(cuid())
  name      String   @unique
  handle    String?
  accent    String?
  avatarUrl String?
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  teams            Team[]
  projects         Project[]
  tasks            Task[]
  meetings         Meeting[]
  liveconEntries   LiveconEntry[]
  calendarEvents   CalendarEvent[]
  sanctionOffenses SanctionOffense[]

  recruitmentSessions      RecruitmentSession[]
  recruitmentQuestions     RecruitmentQuestion[]
  recruitmentStepTemplates RecruitmentStepTemplate[]

  @@index([archived])
  @@map("youtubers")
}

// Gamification tier, Junior then the three squads
model Division {
  id        String   @id @default(cuid())
  name      String   @unique
  glyph     String?
  imagePath String?
  summary   String?
  rank      Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]

  @@map("divisions")
}

// Moderation post held by a member
model JobFunction {
  id        String       @id @default(cuid())
  name      String       @unique
  kind      FunctionKind @default(PRIMARY)
  summary   String?
  accent    String?
  position  Int          @default(0)
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  primaryHolders   Account[]            @relation("PrimaryFunction")
  secondaryHolders Account[]            @relation("SecondaryFunction")
  permissions      FunctionPermission[]
  trainings        Training[]
  skills           Skill[]
  pimStepTemplates PimStepTemplate[]
  academySessions  AcademySession[]

  recruitmentSessions      RecruitmentSession[]
  recruitmentQuestions     RecruitmentQuestion[]
  recruitmentStepTemplates RecruitmentStepTemplate[]

  @@index([kind])
  @@map("job_functions")
}

// Surface where the work actually happens
model Platform {
  id        String   @id @default(cuid())
  name      String   @unique
  accent    String?
  avatarUrl String?
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  communications Communication[]

  @@map("platforms")
}

// Column of a board, scoped to one surface
model WorkflowState {
  id         String        @id @default(cuid())
  scope      WorkflowScope
  name       String
  accent     String?
  position   Int           @default(0)
  isDefault  Boolean       @default(false)
  isTerminal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  projects Project[]
  tasks    Task[]
  meetings Meeting[]

  @@unique([scope, name])
  @@index([scope, position])
  @@map("workflow_states")
}

// Urgency level shared by projects and tasks
model Priority {
  id        String   @id @default(cuid())
  name      String   @unique
  accent    String?
  weight    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  tasks    Task[]

  @@map("priorities")
}

// Group of moderators under one responsable
model Team {
  id         String   @id @default(cuid())
  name       String
  summary    String?
  leadId     String?
  youtuberId String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead     Account?     @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  youtuber Youtuber?    @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  members  TeamMember[]

  @@index([leadId])
  @@index([youtuberId, archived])
  @@map("teams")
}

// Membership of an account inside a team
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  accountId String
  createdAt DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([teamId, accountId])
  @@map("team_members")
}

// Piece of work carried by a responsable
model Project {
  id          String    @id @default(cuid())
  title       String
  emoji       String?
  description String?
  youtuberId  String?
  stateId     String?
  priorityId  String?
  platformId  String?
  deadline    DateTime?
  createdById String?
  updatedById String?
  position    Int       @default(0)
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy Account? @relation("ProjectAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Account? @relation("ProjectEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  youtuber Youtuber?      @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  state    WorkflowState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  priority Priority?      @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  platform Platform?      @relation(fields: [platformId], references: [id], onDelete: SetNull)

  leads          ProjectLead[]
  assistants     ProjectAssistant[]
  communications Communication[]
  tasks          Task[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]

  @@index([stateId, position])
  @@index([youtuberId])
  @@index([archived])
  @@map("projects")
}

// Responsable in charge of a project
model ProjectLead {
  id        String   @id @default(cuid())
  projectId String
  accountId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@map("project_leads")
}

// Helper attached to a project
model ProjectAssistant {
  id        String   @id @default(cuid())
  projectId String
  accountId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@map("project_assistants")
}

// Markdown announcement written for a project
model Communication {
  id          String    @id @default(cuid())
  projectId   String
  authorId    String?
  platformId  String?
  title       String
  body        String    @default("")
  publishedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   Account?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)

  @@index([projectId, position])
  @@map("communications")
}

// Single action assigned to one member
model Task {
  id          String    @id @default(cuid())
  title       String
  emoji       String?
  description String?
  dueDate     DateTime?
  ownerId     String?
  stateId     String?
  priorityId  String?
  youtuberId  String?
  projectId   String?
  createdById String?
  updatedById String?
  position    Int       @default(0)
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy Account? @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Account? @relation("TaskEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  owner    Account?       @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  state    WorkflowState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  priority Priority?      @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  youtuber Youtuber?      @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([stateId, position])
  @@index([ownerId])
  @@index([projectId])
  @@map("tasks")
}

// Scheduled gathering around a project
model Meeting {
  id           String   @id @default(cuid())
  title        String
  emoji        String?
  introduction String?
  outro        String?
  minutes      String?
  scheduledAt  DateTime
  durationMin  Int?
  stateId      String?
  youtuberId   String?
  projectId    String?
  createdById  String?
  updatedById  String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy Account? @relation("MeetingAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Account? @relation("MeetingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  state    WorkflowState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  youtuber Youtuber?      @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  attendees      MeetingAttendee[]
  topics         MeetingTopic[]
  calendarEvents CalendarEvent[]

  @@index([scheduledAt])
  @@index([stateId, position])
  @@map("meetings")
}

// Point covered during a meeting, its emoji drawn before its title
model MeetingTopic {
  id        String   @id @default(cuid())
  meetingId String
  emoji     String
  title     String
  body      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, position])
  @@map("meeting_topics")
}

// Seat held by a member in a meeting
model MeetingAttendee {
  id        String       @id @default(cuid())
  meetingId String
  accountId String
  kind      AttendeeKind @default(PARTICIPANT)
  createdAt DateTime     @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([meetingId, accountId])
  @@index([kind])
  @@map("meeting_attendees")
}

// Time off declared by a member
model Absence {
  id         String        @id @default(cuid())
  accountId  String
  startDate  DateTime
  endDate    DateTime
  dayCount   Int
  reason     String?
  status     AbsenceStatus @default(PENDING)
  reviewerId String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  account  Account  @relation("AbsenceOwner", fields: [accountId], references: [id], onDelete: Cascade)
  reviewer Account? @relation("AbsenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([accountId, startDate])
  @@index([status])
  @@map("absences")
}

// Private remark a responsable leaves on a member
model AccountNote {
  id        String   @id @default(cuid())
  accountId String
  authorId  String?
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account  @relation("NoteSubject", fields: [accountId], references: [id], onDelete: Cascade)
  author  Account? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("account_notes")
}

// Reachable profile of a member elsewhere
model SocialLink {
  id        String   @id @default(cuid())
  accountId String
  label     String
  handle    String
  url       String?
  accent    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, label])
  @@index([accountId, position])
  @@map("social_links")
}

// Entry programme a junior is placed into, ATRIA or PULSE
model Dispositif {
  id        String   @id @default(cuid())
  name      String   @unique
  summary   String?
  accent    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills    Skill[]
  steps     PimStepTemplate[]
  juniors   AcademyJunior[]
  trainings Training[]
  invites   SessionInvite[]

  @@map("dispositifs")
}

// Grouping a skill sits under, Savoir-être, Technique, Rédaction...
model SkillCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  accent    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills Skill[]

  @@map("skill_categories")
}

// One competency a junior is graded on, scoped by function and dispositif
model Skill {
  id           String   @id @default(cuid())
  name         String
  description  String?
  position     Int      @default(0)
  categoryId   String
  functionId   String?
  dispositifId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobFunction JobFunction?  @relation(fields: [functionId], references: [id], onDelete: Cascade)
  dispositif  Dispositif?   @relation(fields: [dispositifId], references: [id], onDelete: Cascade)

  juniorSkills JuniorSkill[]

  @@unique([name, functionId, dispositifId])
  @@index([functionId, dispositifId])
  @@map("skills")
}

// Timeline template step, instantiated onto a session at creation
model PimStepTemplate {
  id           String       @id @default(cuid())
  title        String
  description  String?
  position     Int          @default(0)
  required     Boolean      @default(true)
  functionId   String?
  dispositifId String?
  stage        AcademyStage
  anchor       StepAnchor
  offset       Int
  owner        StepOwner
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  jobFunction JobFunction?  @relation(fields: [functionId], references: [id], onDelete: Cascade)
  dispositif  Dispositif?   @relation(fields: [dispositifId], references: [id], onDelete: Cascade)
  steps       AcademyStep[]

  @@unique([title, functionId, dispositifId])
  @@index([functionId, dispositifId])
  @@map("pim_step_templates")
}

// Course a junior must clear during the academy
model Training {
  id           String         @id @default(cuid())
  name         String         @unique
  summary      String?
  period       AcademyPeriod?
  mandatory    Boolean        @default(false)
  functionId   String?
  dispositifId String?
  position     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  jobFunction JobFunction?      @relation(fields: [functionId], references: [id], onDelete: SetNull)
  dispositif  Dispositif?       @relation(fields: [dispositifId], references: [id], onDelete: SetNull)
  records     TrainingRecord[]
  chapters    TrainingChapter[]

  @@index([period])
  @@index([functionId, dispositifId])
  @@map("trainings")
}

// Section a training's content is split into
model TrainingChapter {
  id         String   @id @default(cuid())
  trainingId String
  title      String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  training Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  blocks   TrainingBlock[]

  @@index([trainingId, position])
  @@map("training_chapters")
}

enum TrainingBlockKind {
  TEXT
  QUIZ
}

// One piece of a chapter, either a written passage or a quiz
model TrainingBlock {
  id        String            @id @default(cuid())
  chapterId String
  kind      TrainingBlockKind
  body      String?
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  chapter   TrainingChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([chapterId, position])
  @@map("training_blocks")
}

// One question of a quiz block
model QuizQuestion {
  id       String  @id @default(cuid())
  blockId  String
  prompt   String
  multiple Boolean @default(false)
  position Int     @default(0)

  block   TrainingBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  choices QuizChoice[]
  answers JuniorAnswer[]

  @@index([blockId, position])
  @@map("quiz_questions")
}

// One offered answer to a quiz question
model QuizChoice {
  id         String  @id @default(cuid())
  questionId String
  label      String
  correct    Boolean @default(false)
  position   Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
  @@map("quiz_choices")
}

// A member's own answer to one quiz question, overwritten on retake
model JuniorAnswer {
  id         String   @id @default(cuid())
  questionId String
  accountId  String
  choiceIds  String[] @default([])
  correct    Boolean
  answeredAt DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  account  Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([questionId, accountId])
  @@map("junior_answers")
}

// Attendance of one member on one training
model TrainingRecord {
  id          String         @id @default(cuid())
  trainingId  String
  accountId   String
  validatorId String?
  status      TrainingStatus @default(NOT_STARTED)
  attempts    Int            @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  abandonedAt DateTime?
  juniorId    String?
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  training  Training       @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  account   Account        @relation("TrainingLearner", fields: [accountId], references: [id], onDelete: Cascade)
  validator Account?       @relation("TrainingValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  junior    AcademyJunior? @relation("TrainingJunior", fields: [juniorId], references: [id], onDelete: SetNull)

  @@unique([trainingId, accountId])
  @@index([juniorId])
  @@map("training_records")
}

// Dated run of one training programme
model AcademySession {
  id         String               @id @default(cuid())
  functionId String
  startsAt   DateTime
  endsAt     DateTime?
  status     AcademySessionStatus @default(DRAFT)
  summary    String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  jobFunction JobFunction @relation(fields: [functionId], references: [id], onDelete: Restrict)

  trainers       AcademySessionTrainer[]
  juniors        AcademyJunior[]
  steps          AcademyStep[]
  calendarEvents CalendarEvent[]
  invites        SessionInvite[]

  @@index([functionId, startsAt])
  @@index([status])
  @@map("academy_sessions")
}

// Public admission link opened once a session takes applications
model SessionInvite {
  id           String   @id @default(cuid())
  sessionId    String
  token        String   @unique
  expiresAt    DateTime
  maxUses      Int?
  uses         Int      @default(0)
  dispositifId String?
  createdById  String?
  createdAt    DateTime @default(now())

  session    AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dispositif Dispositif?    @relation(fields: [dispositifId], references: [id], onDelete: SetNull)
  createdBy  Account?       @relation("SessionInviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("session_invites")
}

// Moderator holding the trainer seat on a session
model AcademySessionTrainer {
  id        String   @id @default(cuid())
  sessionId String
  accountId String
  createdAt DateTime @default(now())

  session AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account Account        @relation("AcademyTrainer", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sessionId, accountId])
  @@map("academy_session_trainers")
}

// Junior followed through one session, always an existing moderator
model AcademyJunior {
  id           String              @id @default(cuid())
  sessionId    String
  accountId    String
  trainerId    String?
  dispositifId String
  status       AcademyJuniorStatus @default(ACTIVE)
  stage        AcademyStage        @default(PREPARATION)
  startedAt    DateTime            @default(now())
  validatedAt  DateTime?
  liveCount    Int                 @default(0)
  bonusLives   Int                 @default(0)
  summary      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  session    AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account    Account        @relation("AcademyJunior", fields: [accountId], references: [id], onDelete: Cascade)
  trainer    Account?       @relation("AcademyJuniorTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  dispositif Dispositif     @relation(fields: [dispositifId], references: [id], onDelete: Restrict)

  steps           AcademyStep[]
  reviews         AcademyReview[]
  skills          JuniorSkill[]
  notes           JuniorNote[]
  objectives      JuniorObjective[]
  trainingRecords TrainingRecord[]  @relation("TrainingJunior")

  @@unique([sessionId, accountId])
  @@index([status])
  @@map("academy_juniors")
}

// Competency grade of one junior on one skill of their function/dispositif
model JuniorSkill {
  id          String   @id @default(cuid())
  juniorId    String
  skillId     String
  percent     Int      @default(0)
  validatorId String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  junior    AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  validator Account?      @relation("JuniorSkillValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  @@unique([juniorId, skillId])
  @@map("junior_skills")
}

// Positive or negative trace kept on a junior's FSI
model JuniorNote {
  id        String       @id @default(cuid())
  juniorId  String
  authorId  String?
  stage     AcademyStage
  kind      NoteKind
  body      String
  createdAt DateTime     @default(now())

  junior AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author Account?      @relation("JuniorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([juniorId, createdAt])
  @@map("junior_notes")
}

// Personal objective, unlocked once a junior reaches the practice stage
model JuniorObjective {
  id          String          @id @default(cuid())
  juniorId    String
  authorId    String?
  title       String
  description String?
  dueAt       DateTime?
  status      ObjectiveStatus @default(OPEN)
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  junior AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author Account?      @relation("JuniorObjectiveAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([juniorId, position])
  @@map("junior_objectives")
}

// Free moment logged on the session thread, or a PIMT template instantiated onto a junior's timeline
model AcademyStep {
  id            String           @id @default(cuid())
  sessionId     String
  juniorId      String?
  authorId      String?
  templateId    String?
  kind          AcademyStepKind?
  title         String
  scheduledAt   DateTime?
  doneAt        DateTime?
  notes         String?
  stage         AcademyStage?
  anchor        StepAnchor?
  offset        Int?
  owner         StepOwner?
  required      Boolean          @default(false)
  validatedById String?
  validatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  session   AcademySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  junior    AcademyJunior?   @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author    Account?         @relation("AcademyStepAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  template  PimStepTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  validator Account?         @relation("AcademyStepValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([sessionId, scheduledAt])
  @@index([kind])
  @@index([juniorId, stage])
  @@map("academy_steps")
}

// Written trace of one voice check-in held with a junior, and the support of the decision
// that authorises the following stage
model AcademyReview {
  id              String       @id @default(cuid())
  juniorId        String
  authorId        String?
  stage           AcademyStage
  heldAt          DateTime
  durationMinutes Int?
  feeling         String?
  summary         String       @default("")
  advice          ReviewAdvice
  status          ReviewStatus @default(DRAFT)
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  junior    AcademyJunior @relation(fields: [juniorId], references: [id], onDelete: Cascade)
  author    Account?      @relation("AcademyReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  decidedBy Account?      @relation("AcademyReviewDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([juniorId, heldAt])
  @@map("academy_reviews")
}

// Pre-designed entry the calendar form starts from, declared from the admin console
model EventTemplate {
  id             String          @id @default(cuid())
  name           String          @unique
  kind           CalendarKind    @default(EVENT)
  summary        String?
  body           String?
  accent         String?
  visibility     EventVisibility @default(EVERYONE)
  defaultMinutes Int?
  allDay         Boolean         @default(false)
  position       Int             @default(0)
  archived       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  events CalendarEvent[]

  @@index([archived])
  @@index([kind])
  @@map("event_templates")
}

// Anything planned on the shared calendar
model CalendarEvent {
  id          String           @id @default(cuid())
  title       String
  emoji       String?
  description String?
  kind        CalendarKind     @default(EVENT)
  templateId  String?
  accent      String?
  ownerId     String?
  accountId   String?
  youtuberId  String?
  projectId   String?
  meetingId   String?
  sessionId   String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean          @default(false)
  visibility  EventVisibility?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  template EventTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  owner    Account?        @relation("CalendarOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  subject  Account?        @relation("CalendarSubject", fields: [accountId], references: [id], onDelete: Cascade)
  youtuber Youtuber?       @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting  Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  session  AcademySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([kind, startsAt])
  @@index([templateId])
  @@index([ownerId])
  @@index([accountId])
  @@map("calendar_events")
}

// Alert tier, lower level means tighter moderation
model LiveconLevel {
  id         String   @id @default(cuid())
  level      Int      @unique
  name       String
  summary    String?
  guidelines String?
  accent     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entries       LiveconEntry[]
  sanctionTiers SanctionTier[]

  @@map("livecon_levels")
}

// Recorded switch to a livecon level
model LiveconEntry {
  id         String    @id @default(cuid())
  levelId    String
  youtuberId String?
  actorId    String?
  reason     String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  level    LiveconLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  youtuber Youtuber?    @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  actor    Account?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([youtuberId, startedAt])
  @@index([endedAt])
  @@map("livecon_entries")
}

// Trace of a fact worth keeping
model ActivityLog {
  id         String   @id @default(cuid())
  eventType  Int
  origin     Int      @default(0)
  actorId    String?
  subjectId  String?
  targetType String?
  targetId   String?
  summary    String
  payload    Json?
  createdAt  DateTime @default(now())

  actor   Account? @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject Account? @relation("LogSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([subjectId, createdAt])
  @@index([targetType, targetId])
  @@index([eventType])
  @@map("activity_logs")
}

// Backing table of StorageManager, bucket comes from STORAGE_BUCKETS
model StorageEntry {
  id        String   @id @default(cuid())
  bucket    String
  key       String
  mimeType  String
  byteSize  Int
  data      Bytes
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bucket, key])
  @@index([bucket])
  @@map("storage_entries")
}

// Nature of a sanction measure
enum SanctionKind {
  DELETE
  WARN
  TIMEOUT
  BAN
}

// Measure applied at one offence tier
model SanctionMeasure {
  id              String       @id @default(cuid())
  name            String       @unique
  kind            SanctionKind @default(TIMEOUT)
  durationMinutes Int?
  permanent       Boolean      @default(false)
  weight          Int          @default(0)
  accent          String?
  position        Int          @default(0)
  archived        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tiers SanctionTier[]

  @@index([weight])
  @@map("sanction_measures")
}

// Offence listed on one creator panel
model SanctionOffense {
  id             String   @id @default(cuid())
  youtuberId     String
  name           String
  summary        String?
  example        String?
  warningExample String?
  accent         String?
  position       Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  youtuber Youtuber       @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  tiers    SanctionTier[]

  @@unique([youtuberId, name])
  @@index([youtuberId, position])
  @@map("sanction_offenses")
}

// Graduated step of one offence inside one livecon panel
model SanctionTier {
  id        String  @id @default(cuid())
  offenseId String
  levelId   String
  step      Int
  measureId String
  note      String?

  offense SanctionOffense @relation(fields: [offenseId], references: [id], onDelete: Cascade)
  level   LiveconLevel    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  measure SanctionMeasure @relation(fields: [measureId], references: [id], onDelete: Restrict)

  @@unique([offenseId, levelId, step])
  @@index([levelId])
  @@map("sanction_tiers")
}

// Phase a recruitment campaign sits in
enum RecruitmentStatus {
  DRAFT
  ANNOUNCED
  INTERVIEWS
  CLOSED
  ARCHIVED
}

// Who carries out a recruitment timeline step
enum RecruitmentOwner {
  RESPONSABLE
  RECRUTEURS
  BOTH
}

// Campaign opened for one creator and one function, announced outside then held on Discord
model RecruitmentSession {
  id           String            @id @default(cuid())
  youtuberId   String
  functionId   String
  name         String
  status       RecruitmentStatus @default(DRAFT)
  summary      String?
  instructions String            @default("")
  opensAt      DateTime?
  closesAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  youtuber    Youtuber               @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  jobFunction JobFunction            @relation(fields: [functionId], references: [id], onDelete: Restrict)
  candidates  RecruitmentCandidate[]
  steps       RecruitmentStep[]

  @@unique([youtuberId, functionId, name])
  @@index([youtuberId, status])
  @@index([functionId])
  @@map("recruitment_sessions")
}

// Applicant of one campaign, held by their Discord identifier and never given an account
model RecruitmentCandidate {
  id          String    @id @default(cuid())
  sessionId   String
  discordId   String
  formId      String?
  recruiterId String?
  outcomeId   String?
  interviewAt DateTime?
  attended    Boolean   @default(false)
  review      String    @default("")
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  session    RecruitmentSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recruiter  Account?               @relation("RecruitmentRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  outcome    RecruitmentOutcome?    @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  spectators RecruitmentSpectator[]
  comments   RecruitmentComment[]

  @@unique([sessionId, discordId])
  @@index([discordId])
  @@index([outcomeId, position])
  @@map("recruitment_candidates")
}

// Moderator sitting in on one interview without leading it
model RecruitmentSpectator {
  candidateId String
  accountId   String

  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  account   Account              @relation("RecruitmentSpectator", fields: [accountId], references: [id], onDelete: Cascade)

  @@id([candidateId, accountId])
  @@index([accountId])
  @@map("recruitment_spectators")
}

// Remark left on a candidate while their application is being weighed
model RecruitmentComment {
  id          String   @id @default(cuid())
  candidateId String
  authorId    String?
  body        String
  createdAt   DateTime @default(now())

  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author    Account?             @relation("RecruitmentCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@map("recruitment_comments")
}

// Column of the results board, declared from the admin console
model RecruitmentOutcome {
  id         String   @id @default(cuid())
  name       String   @unique
  accent     String?
  position   Int      @default(0)
  isDefault  Boolean  @default(false)
  isTerminal Boolean  @default(false)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  candidates RecruitmentCandidate[]

  @@index([position])
  @@map("recruitment_outcomes")
}

// Question of the interview script, narrowed to the creators and functions it fits
model RecruitmentQuestion {
  id         String   @id @default(cuid())
  prompt     String
  hint       String?
  youtuberId String?
  functionId String?
  position   Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  youtuber    Youtuber?    @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  jobFunction JobFunction? @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@index([position])
  @@index([youtuberId, functionId])
  @@map("recruitment_questions")
}

// Trame of timeline steps a campaign instantiates when it is created
model RecruitmentStepTemplate {
  id          String           @id @default(cuid())
  title       String
  description String?
  youtuberId  String?
  functionId  String?
  offset      Int              @default(0)
  owner       RecruitmentOwner @default(RESPONSABLE)
  required    Boolean          @default(false)
  archived    Boolean          @default(false)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  youtuber    Youtuber?         @relation(fields: [youtuberId], references: [id], onDelete: Cascade)
  jobFunction JobFunction?      @relation(fields: [functionId], references: [id], onDelete: Cascade)
  steps       RecruitmentStep[]

  @@index([position])
  @@index([youtuberId, functionId])
  @@map("recruitment_step_templates")
}

// Moment of one campaign timeline, instantiated from the trame then tended by hand
model RecruitmentStep {
  id          String           @id @default(cuid())
  sessionId   String
  templateId  String?
  title       String
  notes       String?
  owner       RecruitmentOwner @default(RESPONSABLE)
  offset      Int              @default(0)
  scheduledAt DateTime?
  doneAt      DateTime?
  required    Boolean          @default(false)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  session  RecruitmentSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  template RecruitmentStepTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([sessionId, position])
  @@map("recruitment_steps")
}
