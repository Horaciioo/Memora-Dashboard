{$DOMAIN} {
	encode zstd gzip

	# Bodies stay small
	request_body {
		max_size 8MB
	}

	# Streams stay open, nothing buffered
	reverse_proxy app:3000 {
		flush_interval -1
		# Client address set here only
		header_up X-Real-IP {client_ip}
		header_up -Cf-Connecting-Ip
	}

	header -Server

	# App down or restarting
	handle_errors {
		@down expression {err.status_code} in [502, 503, 504]
		handle @down {
			rewrite * /maintenance.html
			header Cache-Control "no-store"
			header Retry-After "10"
			file_server {
				root /srv
				status 503
			}
		}
	}
}
