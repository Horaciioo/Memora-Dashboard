# Copy to deploy/.env on the server, never commit it
DOMAIN=memora.example.com
APP_ENV=main
POSTGRES_PASSWORD=change-me

# Then every variable of the app .env (Discord, encryption, Twitch, Sentry...)
# DATABASE_URL and REDIS_URL are set by compose
REDIS_ENABLED=true
QUEUES_ENABLED=true
LOGGER_FILE=false

# Web Push, generated once with: npx web-push generate-vapid-keys
# Changing the keys drops every subscribed device
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Contact handed to Apple and Google, mailto: or https:
PUSH_VAPID_SUBJECT=
